---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Conteo por mesa">
  <h1 class="sr-only">Conteo por mesa</h1>

  <section class="card barra-sel" aria-label="Elegir mesa">
    <div class="selectores">
      <label class="campo campo-distrito">
        <span class="campo-et">Distrito</span>
        <select id="sel-distrito"></select>
      </label>
      <label class="campo campo-colegio">
        <span class="campo-et">Colegio</span>
        <select id="sel-colegio"></select>
      </label>
      <label class="campo campo-aula">
        <span class="campo-et">Aula</span>
        <select id="sel-aula"></select>
      </label>
      <label class="campo campo-mesa">
        <span class="campo-et">Mesa</span>
        <select id="sel-mesa"></select>
      </label>
      <div class="nav-mesa">
        <button type="button" class="btn icono" id="anterior" aria-label="Mesa anterior" title="Mesa anterior">‹</button>
        <button type="button" class="btn icono" id="siguiente" aria-label="Mesa siguiente" title="Mesa siguiente">›</button>
      </div>
    </div>
    <div class="estado-mesa">
      <span class="info"><span id="info"></span><a class="enlace-total" id="total-distrito" href={`${base}/admin/resultados`} data-solo-admin>Total del distrito ›</a></span>
      <span class="chips-estado" aria-live="polite">
        <span class="chip" id="por-confirmar" title="Los números de mesa de este distrito son de la segunda vuelta de junio. Revísalos y corrígelos en Colegios." hidden>
          N° por confirmar
        </span>
        <span class="chip" id="chequeo"></span>
        <span class="chip" id="guardado"></span>
        <span class="chip" data-nube hidden></span>
      </span>
    </div>
  </section>

  <section class="card empty" id="vacio" hidden>
    <p id="vacio-texto"></p>
    <a class="btn primary" href={`${base}/admin/colegios`} data-solo-admin>Ir a Administración › Colegios</a>
    <p class="muted" data-solo-personero>Avísale al administrador para que los agregue.</p>
  </section>

  <div class="tabs" id="tabs" role="tablist" aria-label="Columnas de la cédula"></div>
  <div class="columnas" id="columnas" data-partidos={`${base}/admin/partidos`}></div>

  <!-- Dock flotante de acción (Glassmorphism Pill) -->
  <div class="dock-flotante" id="dock-flotante" hidden>
    <div class="dock-inner">
      <div class="dock-resumen">
        <span class="dock-pulso" id="dock-pulso"></span>
        <span class="dock-texto" id="dock-texto">Mesa lista</span>
      </div>
      <button type="button" class="dock-btn-enviar" id="btn-guardar-mesa">
        <svg viewBox="0 0 20 20" fill="currentColor" width="15" height="15" aria-hidden="true">
          <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z"/>
        </svg>
        <span id="btn-guardar-texto">Enviar Votos</span>
      </button>
    </div>
  </div>
</Layout>

<script>
  import {
    BLANCO,
    MAX_ELECTORES_MESA,
    NULO,
    cargar,
    columnasDe,
    entero,
    esc,
    fmt,
    guardar,
    guardarLocal,
    mesaContada,
    mesas,
    nombreColegio,
    opciones,
    ponerVotos,
    resumen,
    votosDe,
    ubicarMesa,
    type Columna,
    type Mesa,
  } from '../lib/store';
  import {
    conectar,
    nubeActiva,
    subirAhora,
    obtenerVotosConfirmados,
    marcarVotosConfirmados,
  } from '../lib/nube';
  import Swal from 'sweetalert2';
  import 'sweetalert2/dist/sweetalert2.min.css';

  const CLAVE_SEL = 'conteo-votos:seleccion';
  const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
  const d = cargar();
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  const selDistrito = $<HTMLSelectElement>('sel-distrito');
  const selColegio = $<HTMLSelectElement>('sel-colegio');
  const selAula = $<HTMLSelectElement>('sel-aula');
  const selMesa = $<HTMLSelectElement>('sel-mesa');
  const anterior = $<HTMLButtonElement>('anterior');
  const siguiente = $<HTMLButtonElement>('siguiente');
  const info = $('info');
  const totalDistrito = $<HTMLAnchorElement>('total-distrito');
  const porConfirmar = $('por-confirmar');
  const chequeo = $('chequeo');
  const guardado = $('guardado');
  const vacio = $('vacio');
  const tabs = $('tabs');
  const columnas = $('columnas');
  const dockFlotante = $('dock-flotante');
  const dockTexto = $('dock-texto');
  const dockPulso = $('dock-pulso');
  const btnGuardarMesa = $<HTMLButtonElement>('btn-guardar-mesa');
  const btnGuardarTexto = $('btn-guardar-texto');

  let sel = { di: '', c: '', a: '', m: '' };
  let tab = 0;

  try {
    Object.assign(sel, JSON.parse(localStorage.getItem(CLAVE_SEL) ?? '{}'));
  } catch {
    // Sin selección previa.
  }

  // Desde Administración › Mesas se puede abrir una mesa directo: /?mesa=<id>
  const pedida = ubicarMesa(d, new URLSearchParams(location.search).get('mesa') ?? '');
  if (pedida) {
    sel = { di: pedida.distrito.id, c: pedida.colegio.id, a: pedida.aula.id, m: pedida.mesa.id };
    history.replaceState(null, '', location.pathname);
  }

  /** Resuelve la selección actual (o la primera disponible). */
  function actual() {
    const distrito = d.distritos.find((x) => x.id === sel.di) ?? d.distritos[0];
    const colegio = distrito?.colegios.find((x) => x.id === sel.c) ?? distrito?.colegios[0];
    const aula = colegio?.aulas.find((x) => x.id === sel.a) ?? colegio?.aulas[0];
    const mesa = aula?.mesas.find((x) => x.id === sel.m) ?? aula?.mesas[0];
    sel = { di: distrito?.id ?? '', c: colegio?.id ?? '', a: aula?.id ?? '', m: mesa?.id ?? '' };
    try {
      localStorage.setItem(CLAVE_SEL, JSON.stringify(sel));
    } catch {
      // No importa si no se puede recordar.
    }
    return { distrito, colegio, aula, mesa, cols: columnasDe(d, distrito?.id) };
  }

  function pintar() {
    const { distrito, colegio, aula, mesa, cols } = actual();

    opciones(selDistrito, d.distritos.map((x) => ({ id: x.id, nombre: x.corto ?? x.nombre })), sel.di);
    opciones(
      selColegio,
      (distrito?.colegios ?? []).map((c) => ({ id: c.id, nombre: nombreColegio(distrito.colegios, c) })),
      sel.c,
    );
    opciones(selAula, colegio?.aulas ?? [], sel.a);
    // Todas las mesas del colegio, con su aula, para no tener que adivinar en qué aula está cada una.
    opciones(
      selMesa,
      (colegio?.aulas ?? []).flatMap((a) => a.mesas.map((m) => ({ id: m.id, nombre: `${m.numero} · ${a.nombre}` }))),
      sel.m,
    );
    selColegio.disabled = !distrito?.colegios.length;
    selAula.disabled = !colegio?.aulas.length;
    selMesa.disabled = !colegio?.aulas.some((a) => a.mesas.length);
    porConfirmar.hidden = !mesa || !!distrito?.confirmado;

    vacio.hidden = !!mesa;
    tabs.hidden = !mesa;
    dockFlotante.hidden = !mesa;
    if (!mesa) {
      $('vacio-texto').textContent = distrito?.colegios.length
        ? 'Esta aula todavía no tiene mesas.'
        : 'Este distrito aún no tiene colegios registrados.';
      columnas.innerHTML = '';
      pintarEstado();
      return;
    }

    if (tab >= cols.length) tab = 0;
    columnas.style.setProperty('--cols', String(cols.length));
    columnas.classList.toggle('cuatro', cols.length > 3);

    tabs.innerHTML = cols
      .map(
        (col, i) =>
          `<button type="button" role="tab" data-tab="${i}" aria-selected="${i === tab}" title="${esc(col.titulo)}"><span class="tab-et">${esc(col.corto || col.titulo)}</span><span class="tab-n" data-tt="${esc(col.id)}"></span></button>`,
      )
      .join('');

    columnas.innerHTML = cols
      .map(
        (col, i) => `
        <section class="card col-panel${i === tab ? ' active' : ''}" role="tabpanel" aria-label="${esc(col.titulo)}">
          <header class="col-head">
            <h2 title="${esc(col.titulo)}">${esc(col.titulo)}</h2>
            <span class="col-tot" data-tot="${esc(col.id)}"></span>
          </header>
          <ol class="filas">
            ${col.partidos.length ? col.partidos.map((p, j) => fila(mesa, col.id, p.id, String(j + 1), p.nombre)).join('') : sinPartidos(col)}
          </ol>
          <ol class="filas especiales">
            ${fila(mesa, col.id, BLANCO, '', 'Votos en blanco')}
            ${fila(mesa, col.id, NULO, '', 'Votos nulos')}
          </ol>
        </section>`,
      )
      .join('');

    pintarEstado();
  }

  function minimoPermitido(mesaId: string, colId: string, partidoId: string): number {
    const confirmados = obtenerVotosConfirmados(mesaId);
    return Number(confirmados?.[colId]?.[partidoId] ?? 0);
  }

  function obtenerBorradorMesa(mesaId: string): Record<string, Record<string, number>> {
    try {
      const raw = localStorage.getItem(`conteo-votos:borrador:${mesaId}`);
      if (raw) return JSON.parse(raw);
    } catch {}
    return {};
  }

  function guardarBorradorMesa(mesaId: string, b: Record<string, Record<string, number>>) {
    try {
      localStorage.setItem(`conteo-votos:borrador:${mesaId}`, JSON.stringify(b));
    } catch {}
  }

  function limpiarBorradorMesa(mesaId: string) {
    try {
      localStorage.removeItem(`conteo-votos:borrador:${mesaId}`);
    } catch {}
  }

  function votoActual(mesa: Mesa, colId: string, pId: string): number {
    const borrador = obtenerBorradorMesa(mesa.id);
    if (borrador[colId] && typeof borrador[colId][pId] === 'number') {
      return borrador[colId][pId];
    }
    return votosDe(mesa, colId, pId);
  }

  function ponerVotoBorrador(mesa: Mesa, colId: string, pId: string, n: number) {
    const borrador = obtenerBorradorMesa(mesa.id);
    if (!Object.keys(borrador).length && mesa.votos) {
      Object.assign(borrador, structuredClone(mesa.votos));
    }
    (borrador[colId] ??= {})[pId] = entero(n);
    guardarBorradorMesa(mesa.id, borrador);
  }

  function mesaTieneCambiosSinEnviar(mesa: Mesa): boolean {
    const borrador = obtenerBorradorMesa(mesa.id);
    if (!Object.keys(borrador).length) return false;
    const oficiales = mesa.votos ?? {};
    const cols = new Set([...Object.keys(borrador), ...Object.keys(oficiales)]);
    for (const c of cols) {
      const p1 = borrador[c] ?? {};
      const p2 = oficiales[c] ?? {};
      const partidos = new Set([...Object.keys(p1), ...Object.keys(p2)]);
      for (const p of partidos) {
        if (Number(p1[p] ?? 0) !== Number(p2[p] ?? 0)) return true;
      }
    }
    return false;
  }

  function fila(mesa: Mesa, col: string, p: string, num: string, nombre: string) {
    const v = votoActual(mesa, col, p);
    const min = minimoPermitido(mesa.id, col, p);
    return `
      <li class="fila${v > 0 ? ' con-votos' : ''}" data-col="${esc(col)}" data-p="${esc(p)}" data-min="${min}" data-nombre="${esc(nombre)}">
        <span class="num">${num}</span>
        <span class="nombre" title="${esc(nombre)}">${esc(nombre)}</span>
        <span class="stepper">
          <button type="button" data-d="-1" tabindex="-1" aria-label="Restar un voto a ${esc(nombre)}"${v <= min ? ' disabled' : ''}>−</button>
          <input type="number" inputmode="numeric" enterkeyhint="next" min="${min}" step="1" value="${v}" aria-label="Votos de ${esc(nombre)}" />
          <button type="button" data-d="1" tabindex="-1" aria-label="Sumar un voto a ${esc(nombre)}">+</button>
        </span>
      </li>`;
  }

  const sinPartidos = (col: Columna) => {
    // «Distrito de Pitipo» → «distrito de Pitipo» (el nombre sigue con mayúscula).
    const titulo = col.titulo.charAt(0).toLowerCase() + col.titulo.slice(1);
    const cual = col.distrito ? `para alcalde del ${esc(titulo)}` : `de «${esc(col.titulo)}»`;
    // El administrador ve por qué faltan y dónde agregarlos; el personero, solo a quién avisar.
    return `
    <li class="fila-vacia">
      <span data-solo-admin>
        ${col.distrito ? `Faltan los partidos ${cual}: no venían en las listas cargadas.` : `Todavía no hay partidos ${cual}.`}
        <a href="${esc(columnas.dataset.partidos)}?columna=${encodeURIComponent(col.id)}">Agrégalos en Administración › Partidos.</a>
      </span>
      <span data-solo-personero>Todavía no están los partidos ${cual}. Avísale al administrador.</span>
    </li>`;
  };

  /** Totales por columna, avisos y barra de estado de la mesa actual. */
  function pintarEstado(ok = true) {
    const { distrito, colegio, mesa, cols } = actual();
    const lista = mesas(d, { distrito: distrito?.id });
    const i = lista.findIndex((u) => u.mesa.id === sel.m);
    anterior.disabled = i <= 0;
    siguiente.disabled = i < 0 || i >= lista.length - 1;

    const contadas = lista.filter((u) => mesaContada(d, u.mesa)).length;
    info.textContent = [
      colegio?.codigo && `Local ${colegio.codigo}`,
      mesa?.electores && `${fmt(mesa.electores)} electores`,
      i >= 0 && `Mesa ${i + 1}/${lista.length}`,
      lista.length && `${contadas} ${contadas === 1 ? 'contada' : 'contadas'}`,
    ]
      .filter(Boolean)
      .join(' · ');
    // La suma de todas las mesas del distrito está en Resultados.
    totalDistrito.hidden = !distrito;
    if (distrito) {
      totalDistrito.href = `${BASE}/admin/resultados?distrito=${encodeURIComponent(distrito.id)}`;
      totalDistrito.title = `Suma de todas las mesas del distrito de ${distrito.nombre}`;
    }

    // Con Supabase, el estado de guardado lo muestra la nube.
    guardado.className = ok ? 'chip' : 'chip error';
    guardado.textContent = ok ? '✓ Guardado' : '⚠ No se pudo guardar';
    guardado.hidden = !mesa || nubeActiva;
    chequeo.hidden = !mesa;
    if (!mesa) return;

    const borrador = obtenerBorradorMesa(mesa.id);
    const votosTrabajo = Object.keys(borrador).length ? borrador : (mesa.votos ?? {});
    const mesaTrabajo: Mesa = { ...mesa, votos: votosTrabajo };

    const totales = cols.map((col) => ({ col, r: resumen(col, [mesaTrabajo]) }));
    const ns = totales.map((t) => t.r.emitidos);
    const mayor = Math.max(0, ...ns);
    const faltan = totales.filter((t) => t.r.emitidos === 0);
    // Solo se avisa cuando todas las columnas tienen votos y no coinciden.
    const distintos = !faltan.length && new Set(ns).size > 1;

    for (const { col, r } of totales) {
      // Cada cédula cuenta en todas las columnas: se marcan las que tienen menos votos.
      const marcar = distintos && r.emitidos !== mayor;
      const tot = columnas.querySelector<HTMLElement>(`[data-tot="${CSS.escape(col.id)}"]`);
      if (tot) {
        tot.className = marcar ? 'col-tot warn' : 'col-tot';
        tot.innerHTML = `<b title="${fmt(r.validos)} válidos · ${fmt(r.emitidos)} emitidos">${fmt(r.emitidos)}</b>`;
      }
      const tt = tabs.querySelector<HTMLElement>(`[data-tt="${CSS.escape(col.id)}"]`);
      if (tt) {
        tt.className = marcar ? 'tab-n warn' : 'tab-n';
        tt.textContent = fmt(r.emitidos);
      }
    }

    if (mayor > (mesa.electores || MAX_ELECTORES_MESA)) {
      chequeo.className = 'chip error';
      chequeo.textContent = mesa.electores
        ? `⚠ Más votos que electores (${fmt(mayor)} de ${fmt(mesa.electores)})`
        : `⚠ Más de ${MAX_ELECTORES_MESA} votos: ninguna mesa tiene más electores`;
    } else if (distintos) {
      chequeo.className = 'chip warn';
      chequeo.textContent = `⚠ Totales no coinciden (${ns.map(fmt).join(' · ')})`;
    } else if (mayor > 0 && faltan.length) {
      chequeo.className = 'chip';
      chequeo.textContent = `Falta: ${faltan.map((t) => t.col.corto || t.col.titulo).join(', ')}`;
    } else if (mayor > 0) {
      chequeo.className = 'chip ok';
      chequeo.textContent = '✓ Totales coinciden';
    } else {
      chequeo.className = 'chip';
      chequeo.textContent = 'Sin votos todavía';
    }

    if (dockFlotante && mesa) {
      dockFlotante.hidden = false;
      const emitidos = Math.max(0, ...ns);
      const hayPendientes = mesaTieneCambiosSinEnviar(mesa);

      if (hayPendientes) {
        dockPulso.className = 'dock-pulso warn';
        dockTexto.innerHTML = `Mesa <b>${esc(mesa.numero)}</b> · ${emitidos > 0 ? `<b>${fmt(emitidos)}</b> votos` : 'Sin votos'} <span style="font-size:11px; opacity:0.9; color:var(--warn); font-weight:750;">(Pendiente de envío)</span>`;
      } else {
        dockPulso.className = 'dock-pulso';
        dockTexto.innerHTML = `Mesa <b>${esc(mesa.numero)}</b> · ${emitidos > 0 ? `<b>${fmt(emitidos)}</b> votos` : 'Sin votos'} <span style="font-size:11px; opacity:0.95; color:var(--ok); font-weight:700;">✓ Registrado en la central</span>`;
      }
    }
  }

  function cambiar(li: HTMLElement, n: number) {
    const { mesa } = actual();
    if (!mesa) return;
    const min = Number(li.dataset.min ?? 0);
    const valorFinal = Math.max(min, n);
    ponerVotoBorrador(mesa, li.dataset.col!, li.dataset.p!, valorFinal);
    li.classList.toggle('con-votos', valorFinal > 0);
    const btnMenos = li.querySelector<HTMLButtonElement>('button[data-d="-1"]');
    if (btnMenos) btnMenos.disabled = valorFinal <= min;
    pintarEstado();
  }

  /** Mesa anterior o siguiente dentro del distrito. */
  function irA(paso: number) {
    const lista = mesas(d, { distrito: sel.di });
    const i = lista.findIndex((u) => u.mesa.id === sel.m);
    const destino = lista[i + paso];
    if (!destino) return;
    sel = { di: destino.distrito.id, c: destino.colegio.id, a: destino.aula.id, m: destino.mesa.id };
    pintar();
  }

  selDistrito.addEventListener('change', () => {
    sel = { di: selDistrito.value, c: '', a: '', m: '' };
    pintar();
  });
  selColegio.addEventListener('change', () => {
    sel = { ...sel, c: selColegio.value, a: '', m: '' };
    pintar();
  });
  selAula.addEventListener('change', () => {
    sel = { ...sel, a: selAula.value, m: '' };
    pintar();
  });
  selMesa.addEventListener('change', () => {
    // Al elegir la mesa se pone sola su aula.
    const aula = actual().colegio?.aulas.find((a) => a.mesas.some((m) => m.id === selMesa.value));
    sel = { ...sel, a: aula?.id ?? sel.a, m: selMesa.value };
    pintar();
  });
  anterior.addEventListener('click', () => irA(-1));
  siguiente.addEventListener('click', () => irA(1));

  tabs.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tab]');
    if (!b) return;
    tab = Number(b.dataset.tab);
    tabs.querySelectorAll('[data-tab]').forEach((x, i) => x.setAttribute('aria-selected', String(i === tab)));
    columnas.querySelectorAll('.col-panel').forEach((x, i) => x.classList.toggle('active', i === tab));
  });

  columnas.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-d]');
    const li = b?.closest<HTMLElement>('.fila');
    const input = li?.querySelector('input');
    if (!b || !li || !input) return;
    const min = Number(li.dataset.min ?? 0);
    const actualVal = entero(input.value);
    const delta = Number(b.dataset.d);
    if (delta < 0 && actualVal <= min) {
      if (min > 0) {
        Swal.fire({
          ...swalConfig(),
          icon: 'warning',
          title: 'Límite alcanzado',
          html: `Ya se registraron <b>${min} votos</b> para este partido.<br><br>No puedes reducir una cantidad ya registrada en el sistema.`,
          confirmButtonText: 'Entendido',
        });
      }
      return;
    }
    const n = Math.max(min, actualVal + delta);
    input.value = String(n);
    cambiar(li, n);
  });

  columnas.addEventListener('input', (e) => {
    const input = e.target as HTMLInputElement;
    const li = input.closest<HTMLElement>('.fila');
    if (input.tagName === 'INPUT' && li) {
      const val = entero(input.value);
      cambiar(li, val);
    }
  });

  // Al salir del campo, valida que no sea menor al mínimo registrado
  columnas.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    const li = input.closest<HTMLElement>('.fila');
    if (input.tagName === 'INPUT' && li) {
      const min = Number(li.dataset.min ?? 0);
      const val = entero(input.value);
      const nombre = li.dataset.nombre || 'este partido';
      if (val < min) {
        input.value = String(min);
        cambiar(li, min);
        Swal.fire({
          ...swalConfig(),
          icon: 'warning',
          title: 'Cantidad no permitida',
          html: `<b>${nombre}</b> ya tiene <b>${min} votos registrados</b>.<br><br>El valor ingresado no puede ser menor a ${min}; debe ser <b>mayor o igual a ${min}</b>.`,
          confirmButtonText: 'Entendido',
        });
        return;
      }
      input.value = String(val);
      cambiar(li, val);
    }
  });

  columnas.addEventListener('focusin', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.tagName === 'INPUT') input.select();
  });

  // Enter pasa al siguiente partido, como al llenar el acta.
  columnas.addEventListener('keydown', (e) => {
    const input = e.target as HTMLInputElement;
    if (e.key !== 'Enter' || input.tagName !== 'INPUT') return;
    e.preventDefault();
    const visibles = [...columnas.querySelectorAll<HTMLInputElement>('input')].filter((x) => x.offsetParent);
    const sig = visibles[visibles.indexOf(input) + 1];
    if (sig) sig.focus();
    else input.blur();
  });

  function swalConfig() {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    return {
      customClass: {
        popup: 'swal-custom-popup',
        confirmButton: 'btn primary swal-btn-confirm',
        cancelButton: 'btn swal-btn-cancel',
      },
      buttonsStyling: false,
      background: isDark ? '#161b26' : '#ffffff',
      color: isDark ? '#e8ebf1' : '#101828',
    };
  }

  async function enviarVotosMesa() {
    const { mesa, cols } = actual();
    if (!mesa) return;

    const borrador = obtenerBorradorMesa(mesa.id);
    const votosAEnviar = Object.keys(borrador).length ? borrador : (mesa.votos ?? {});

    // 1. Validar que ningún voto sea menor al mínimo registrado previamente
    for (const col of cols) {
      for (const p of col.partidos) {
        const v = Number(votosAEnviar?.[col.id]?.[p.id] ?? 0);
        const min = minimoPermitido(mesa.id, col.id, p.id);
        if (v < min) {
          Swal.fire({
            ...swalConfig(),
            icon: 'error',
            title: 'Cantidad no permitida',
            html: `El partido <b>${esc(p.nombre)}</b> tiene ${v} votos, pero ya se habían registrado <b>${min} votos</b>.<br><br>Debe ser mayor o igual a ${min}.`,
            confirmButtonText: 'Corregir',
          });
          return;
        }
      }
      for (const esp of [BLANCO, NULO]) {
        const v = Number(votosAEnviar?.[col.id]?.[esp] ?? 0);
        const min = minimoPermitido(mesa.id, col.id, esp);
        if (v < min) {
          const nom = esp === BLANCO ? 'Votos en blanco' : 'Votos nulos';
          Swal.fire({
            ...swalConfig(),
            icon: 'error',
            title: 'Cantidad no permitida',
            html: `Los <b>${nom}</b> tienen ${v}, pero ya se habían registrado <b>${min} votos</b>.<br><br>Debe ser mayor o igual a ${min}.`,
            confirmButtonText: 'Corregir',
          });
          return;
        }
      }
    }

    // 2. Advertencia preventiva si faltan columnas por llenar
    const mesaTrabajo: Mesa = { ...mesa, votos: votosAEnviar };
    const totales = cols.map((col) => ({ col, r: resumen(col, [mesaTrabajo]) }));
    const faltan = totales.filter((t) => t.r.emitidos === 0);
    const algunoTiene = totales.some((t) => t.r.emitidos > 0);

    if (faltan.length > 0 && algunoTiene) {
      const nombres = faltan.map((t) => t.col.corto || t.col.titulo).join(', ');
      const res = await Swal.fire({
        ...swalConfig(),
        title: '¿Enviar mesa incompleta?',
        html: `Todavía no has anotado votos para:<br><b style="color: var(--warn, #eab308); font-size: 1.05em; display: inline-block; margin-top: 6px;">${nombres}</b><br><br><span style="font-size: 13px; opacity: 0.85;">¿Deseas enviar los resultados de todas maneras?</span>`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonText: 'Sí, enviar de todos modos',
        cancelButtonText: 'Revisar votos',
        reverseButtons: true,
        focusCancel: true,
      });
      if (!res.isConfirmed) return;
    }

    const conf = await Swal.fire({
      ...swalConfig(),
      title: `¿Confirmar y enviar Mesa ${mesa.numero}?`,
      text: 'Los votos se registrarán de manera definitiva en el conteo de la central.',
      icon: 'question',
      showCancelButton: true,
      confirmButtonText: 'Sí, registrar en la central',
      cancelButtonText: 'Cancelar',
    });
    if (!conf.isConfirmed) return;

    btnGuardarMesa.disabled = true;
    btnGuardarTexto.textContent = 'Enviando…';

    Swal.fire({
      ...swalConfig(),
      title: 'Enviando a la central…',
      text: `Sincronizando votos de la Mesa ${mesa.numero}`,
      allowOutsideClick: false,
      allowEscapeKey: false,
      didOpen: () => {
        Swal.showLoading();
      },
    });

    try {
      mesa.votos = structuredClone(votosAEnviar);
      limpiarBorradorMesa(mesa.id);
      guardar(d);
      const res = await subirAhora(d);
      if (res.ok) {
        marcarVotosConfirmados(mesa.id, mesa.votos ?? {});
        Swal.fire({
          ...swalConfig(),
          icon: 'success',
          title: '¡Mesa Enviada!',
          text: res.mensaje || `Los votos de la Mesa ${mesa.numero} se guardaron exitosamente en la central.`,
          timer: 2300,
          showConfirmButton: false,
        });
      } else if (res.estado === 'pendiente') {
        marcarVotosConfirmados(mesa.id, mesa.votos ?? {});
        Swal.fire({
          ...swalConfig(),
          icon: 'info',
          title: 'Guardado en tu celular',
          text: 'Sin conexión en este momento. Los votos se subirán automáticamente apenas recuperes señal.',
          confirmButtonText: 'Entendido',
        });
      } else {
        Swal.fire({
          ...swalConfig(),
          icon: 'error',
          title: 'Aviso de sincronización',
          text: res.mensaje || 'No se pudo contactar con Supabase.',
          confirmButtonText: 'Cerrar',
        });
      }
    } catch {
      Swal.fire({
        ...swalConfig(),
        icon: 'warning',
        title: 'Guardado localmente',
        text: 'Hubo un inconveniente de red. Los datos quedaron guardados en este dispositivo y se sincronizarán solos.',
        confirmButtonText: 'Entendido',
      });
    } finally {
      btnGuardarMesa.disabled = false;
      btnGuardarTexto.textContent = 'Enviar a la central';
      pintar();
    }
  }

  btnGuardarMesa?.addEventListener('click', enviarVotosMesa);

  pintar();
  conectar(d, pintar);
</script>

