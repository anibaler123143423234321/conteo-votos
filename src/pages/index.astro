---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Conteo por mesa">
  <section class="card">
    <div class="page-head">
      <h1>Conteo por mesa</h1>
      <span class="muted" id="ubicacion"></span>
    </div>
    <div class="grid-3">
      <label>Colegio <select id="sel-colegio"></select></label>
      <label>Aula <select id="sel-aula"></select></label>
      <label>Mesa <select id="sel-mesa"></select></label>
    </div>
    <p class="mesa-info muted" id="mesa-info" hidden></p>
    <div class="barra-mesa">
      <button type="button" class="btn" id="anterior">← Anterior</button>
      <span class="progreso" id="progreso" aria-live="polite"></span>
      <button type="button" class="btn" id="siguiente">Siguiente →</button>
    </div>
  </section>

  <section class="card empty" id="vacio" hidden>
    <p id="vacio-texto"></p>
    <a class="btn primary" href={`${base}/colegios`}>Ir a Colegios y mesas</a>
  </section>

  <div class="aviso" id="aviso" role="status" hidden></div>
  <div class="tabs" id="tabs" role="tablist" aria-label="Columnas de la cédula"></div>
  <div class="columnas" id="columnas"></div>
</Layout>

<script>
  import {
    BLANCO,
    NULO,
    cargar,
    entero,
    esc,
    fmt,
    guardar,
    mesaContada,
    mesas,
    nombreColegio,
    opciones,
    ponerVotos,
    resumen,
    votosDe,
    type Mesa,
  } from '../lib/store';

  const CLAVE_SEL = 'conteo-votos:seleccion';
  const d = cargar();
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  const selColegio = $<HTMLSelectElement>('sel-colegio');
  const selAula = $<HTMLSelectElement>('sel-aula');
  const selMesa = $<HTMLSelectElement>('sel-mesa');
  const anterior = $<HTMLButtonElement>('anterior');
  const siguiente = $<HTMLButtonElement>('siguiente');
  const progreso = $('progreso');
  const vacio = $('vacio');
  const aviso = $('aviso');
  const tabs = $('tabs');
  const columnas = $('columnas');

  let sel = { c: '', a: '', m: '' };
  let tab = 0;
  let guardadoOk = true;

  try {
    Object.assign(sel, JSON.parse(localStorage.getItem(CLAVE_SEL) ?? '{}'));
  } catch {
    // Sin selección previa.
  }

  /** Resuelve la selección actual (o la primera disponible). */
  function actual() {
    const colegio = d.colegios.find((x) => x.id === sel.c) ?? d.colegios[0];
    const aula = colegio?.aulas.find((x) => x.id === sel.a) ?? colegio?.aulas[0];
    const mesa = aula?.mesas.find((x) => x.id === sel.m) ?? aula?.mesas[0];
    sel = { c: colegio?.id ?? '', a: aula?.id ?? '', m: mesa?.id ?? '' };
    try {
      localStorage.setItem(CLAVE_SEL, JSON.stringify(sel));
    } catch {
      // No importa si no se puede recordar.
    }
    return { colegio, aula, mesa };
  }

  function pintar() {
    const { colegio, aula, mesa } = actual();
    $('ubicacion').textContent = `Distrito ${d.distrito} · Provincia ${d.provincia}`;

    opciones(
      selColegio,
      d.colegios.map((c) => ({ id: c.id, nombre: nombreColegio(d, c) })),
      sel.c,
    );
    opciones(selAula, colegio?.aulas ?? [], sel.a);
    opciones(
      selMesa,
      (aula?.mesas ?? []).map((m) => ({ id: m.id, nombre: `Mesa ${m.numero}` })),
      sel.m,
    );
    selColegio.disabled = !d.colegios.length;
    selAula.disabled = !colegio?.aulas.length;
    selMesa.disabled = !aula?.mesas.length;

    const info = [
      colegio?.codigo && `Local ONPE ${colegio.codigo}`,
      mesa?.electores && `${fmt(mesa.electores)} electores hábiles`,
    ].filter(Boolean);
    $('mesa-info').textContent = info.join(' · ');
    $('mesa-info').hidden = !info.length;

    pintarProgreso();

    vacio.hidden = !!mesa;
    tabs.hidden = !mesa;
    if (!mesa) {
      $('vacio-texto').textContent = d.colegios.length
        ? 'Esta aula todavía no tiene mesas.'
        : 'Aún no hay colegios registrados. Primero crea los colegios, aulas y mesas.';
      columnas.innerHTML = '';
      aviso.hidden = true;
      return;
    }

    tabs.innerHTML = d.columnas
      .map(
        (col, i) =>
          `<button type="button" role="tab" data-tab="${i}" aria-selected="${i === tab}">${esc(col.corto || col.titulo)}<span class="tab-total" data-tt="${esc(col.id)}"></span></button>`,
      )
      .join('');

    columnas.innerHTML = d.columnas
      .map(
        (col, i) => `
        <section class="card col-panel${i === tab ? ' active' : ''}" role="tabpanel">
          <h2>${esc(col.titulo)}</h2>
          <ol class="filas">
            ${col.partidos.map((p, j) => fila(mesa, col.id, p.id, String(j + 1), p.nombre)).join('')}
          </ol>
          <ol class="filas especiales">
            ${fila(mesa, col.id, BLANCO, '', 'Votos en blanco')}
            ${fila(mesa, col.id, NULO, '', 'Votos nulos')}
          </ol>
          <dl class="totales" data-tot="${esc(col.id)}"></dl>
        </section>`,
      )
      .join('');

    d.columnas.forEach((col) => pintarTotales(mesa, col.id));
    pintarAviso(mesa);
  }

  function fila(mesa: Mesa, col: string, p: string, num: string, nombre: string) {
    return `
      <li class="fila" data-col="${esc(col)}" data-p="${esc(p)}">
        <span class="num">${num}</span>
        <span class="nombre">${esc(nombre)}</span>
        <div class="stepper">
          <button type="button" data-d="-1" aria-label="Restar un voto a ${esc(nombre)}">−</button>
          <input type="number" inputmode="numeric" min="0" step="1" value="${votosDe(mesa, col, p)}" aria-label="Votos de ${esc(nombre)}" />
          <button type="button" data-d="1" aria-label="Sumar un voto a ${esc(nombre)}">+</button>
        </div>
      </li>`;
  }

  function pintarTotales(mesa: Mesa, colId: string) {
    const col = d.columnas.find((c) => c.id === colId);
    const el = columnas.querySelector(`[data-tot="${CSS.escape(colId)}"]`);
    if (!col || !el) return;
    const r = resumen(col, [mesa]);
    el.innerHTML = `
      <div><dt>Válidos</dt><dd>${fmt(r.validos)}</dd></div>
      <div><dt>En blanco</dt><dd>${fmt(r.blanco)}</dd></div>
      <div><dt>Nulos</dt><dd>${fmt(r.nulo)}</dd></div>
      <div class="total"><dt>Total emitidos</dt><dd>${fmt(r.emitidos)}</dd></div>`;
    const tt = tabs.querySelector(`[data-tt="${CSS.escape(colId)}"]`);
    if (tt) tt.textContent = `${fmt(r.emitidos)} ${r.emitidos === 1 ? 'voto' : 'votos'}`;
  }

  function pintarAviso(mesa: Mesa) {
    const totales = d.columnas.map((col) => ({ col, n: resumen(col, [mesa]).emitidos }));
    const avisos: string[] = [];
    // Cada elector marca todas las columnas: los totales deberían coincidir.
    if (new Set(totales.map((t) => t.n)).size > 1) {
      avisos.push(
        `Revisa el conteo: los totales no coinciden entre columnas (${totales
          .map((t) => `${t.col.corto || t.col.titulo}: ${fmt(t.n)}`)
          .join(' · ')}).`,
      );
    }
    const mayor = Math.max(0, ...totales.map((t) => t.n));
    if (mesa.electores && mayor > mesa.electores) {
      avisos.push(
        `Hay más votos (${fmt(mayor)}) que electores hábiles (${fmt(mesa.electores)}) en esta mesa.`,
      );
    }
    aviso.hidden = !avisos.length;
    aviso.innerHTML = avisos.map(esc).join('<br />');
  }

  function pintarProgreso() {
    const lista = mesas(d);
    const i = lista.findIndex((u) => u.mesa.id === sel.m);
    const contadas = lista.filter((u) => mesaContada(d, u.mesa)).length;
    progreso.textContent = lista.length
      ? `Mesa ${i + 1} de ${lista.length} · ${contadas} con votos · ${guardadoOk ? 'Guardado' : '⚠ No se pudo guardar'}`
      : '';
    anterior.disabled = i <= 0;
    siguiente.disabled = i < 0 || i >= lista.length - 1;
  }

  function cambiar(li: HTMLElement, n: number) {
    const { mesa } = actual();
    if (!mesa) return;
    const col = li.dataset.col!;
    ponerVotos(mesa, col, li.dataset.p!, n);
    guardadoOk = guardar(d);
    pintarTotales(mesa, col);
    pintarAviso(mesa);
    pintarProgreso();
  }

  function irA(paso: number) {
    const lista = mesas(d);
    const i = lista.findIndex((u) => u.mesa.id === sel.m);
    const destino = lista[i + paso];
    if (!destino) return;
    sel = { c: destino.colegio.id, a: destino.aula.id, m: destino.mesa.id };
    pintar();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  selColegio.addEventListener('change', () => {
    sel = { c: selColegio.value, a: '', m: '' };
    pintar();
  });
  selAula.addEventListener('change', () => {
    sel = { ...sel, a: selAula.value, m: '' };
    pintar();
  });
  selMesa.addEventListener('change', () => {
    sel = { ...sel, m: selMesa.value };
    pintar();
  });
  anterior.addEventListener('click', () => irA(-1));
  siguiente.addEventListener('click', () => irA(1));

  tabs.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tab]');
    if (!b) return;
    tab = Number(b.dataset.tab);
    tabs.querySelectorAll('[data-tab]').forEach((x, i) => x.setAttribute('aria-selected', String(i === tab)));
    columnas.querySelectorAll('.col-panel').forEach((x, i) => x.classList.toggle('active', i === tab));
  });

  columnas.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-d]');
    const li = b?.closest<HTMLElement>('.fila');
    const input = li?.querySelector('input');
    if (!b || !li || !input) return;
    const n = Math.max(0, entero(input.value) + Number(b.dataset.d));
    input.value = String(n);
    cambiar(li, n);
  });

  columnas.addEventListener('input', (e) => {
    const input = e.target as HTMLInputElement;
    const li = input.closest<HTMLElement>('.fila');
    if (input.tagName === 'INPUT' && li) cambiar(li, entero(input.value));
  });

  // Al salir del campo, muestra el valor normalizado (sin negativos ni decimales).
  columnas.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.tagName === 'INPUT') input.value = String(entero(input.value));
  });

  columnas.addEventListener('focusin', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.tagName === 'INPUT') input.select();
  });

  pintar();
</script>
