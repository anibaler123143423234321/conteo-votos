---
import Layout from '../layouts/Layout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Conteo por mesa">
  <h1 class="sr-only">Conteo por mesa</h1>

  <section class="card barra-sel" aria-label="Elegir mesa">
    <div class="selectores">
      <label class="campo campo-colegio">
        <span class="campo-et">Colegio</span>
        <select id="sel-colegio"></select>
      </label>
      <label class="campo">
        <span class="campo-et">Aula</span>
        <select id="sel-aula"></select>
      </label>
      <label class="campo">
        <span class="campo-et">Mesa</span>
        <select id="sel-mesa"></select>
      </label>
      <div class="nav-mesa">
        <button type="button" class="btn icono" id="anterior" aria-label="Mesa anterior" title="Mesa anterior">‹</button>
        <button type="button" class="btn icono" id="siguiente" aria-label="Mesa siguiente" title="Mesa siguiente">›</button>
      </div>
    </div>
    <div class="estado-mesa">
      <span class="info" id="info"></span>
      <span class="chips-estado" aria-live="polite">
        <span class="chip" id="chequeo"></span>
        <span class="chip" id="guardado"></span>
      </span>
    </div>
  </section>

  <section class="card empty" id="vacio" hidden>
    <p id="vacio-texto"></p>
    <a class="btn primary" href={`${base}/colegios`}>Ir a Colegios y mesas</a>
  </section>

  <div class="tabs" id="tabs" role="tablist" aria-label="Columnas de la cédula"></div>
  <div class="columnas" id="columnas"></div>
</Layout>

<script>
  import {
    BLANCO,
    NULO,
    cargar,
    entero,
    esc,
    fmt,
    guardar,
    mesaContada,
    mesas,
    nombreColegio,
    opciones,
    ponerVotos,
    resumen,
    votosDe,
    type Mesa,
  } from '../lib/store';

  const CLAVE_SEL = 'conteo-votos:seleccion';
  const d = cargar();
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  const selColegio = $<HTMLSelectElement>('sel-colegio');
  const selAula = $<HTMLSelectElement>('sel-aula');
  const selMesa = $<HTMLSelectElement>('sel-mesa');
  const anterior = $<HTMLButtonElement>('anterior');
  const siguiente = $<HTMLButtonElement>('siguiente');
  const info = $('info');
  const chequeo = $('chequeo');
  const guardado = $('guardado');
  const vacio = $('vacio');
  const tabs = $('tabs');
  const columnas = $('columnas');

  let sel = { c: '', a: '', m: '' };
  let tab = 0;

  try {
    Object.assign(sel, JSON.parse(localStorage.getItem(CLAVE_SEL) ?? '{}'));
  } catch {
    // Sin selección previa.
  }

  /** Resuelve la selección actual (o la primera disponible). */
  function actual() {
    const colegio = d.colegios.find((x) => x.id === sel.c) ?? d.colegios[0];
    const aula = colegio?.aulas.find((x) => x.id === sel.a) ?? colegio?.aulas[0];
    const mesa = aula?.mesas.find((x) => x.id === sel.m) ?? aula?.mesas[0];
    sel = { c: colegio?.id ?? '', a: aula?.id ?? '', m: mesa?.id ?? '' };
    try {
      localStorage.setItem(CLAVE_SEL, JSON.stringify(sel));
    } catch {
      // No importa si no se puede recordar.
    }
    return { colegio, aula, mesa };
  }

  function pintar() {
    const { colegio, aula, mesa } = actual();

    opciones(
      selColegio,
      d.colegios.map((c) => ({ id: c.id, nombre: nombreColegio(d, c) })),
      sel.c,
    );
    opciones(selAula, colegio?.aulas ?? [], sel.a);
    opciones(selMesa, (aula?.mesas ?? []).map((m) => ({ id: m.id, nombre: m.numero })), sel.m);
    selColegio.disabled = !d.colegios.length;
    selAula.disabled = !colegio?.aulas.length;
    selMesa.disabled = !aula?.mesas.length;

    vacio.hidden = !!mesa;
    tabs.hidden = !mesa;
    if (!mesa) {
      $('vacio-texto').textContent = d.colegios.length
        ? 'Esta aula todavía no tiene mesas.'
        : 'Aún no hay colegios registrados. Primero crea los colegios, aulas y mesas.';
      columnas.innerHTML = '';
      pintarEstado();
      return;
    }

    tabs.innerHTML = d.columnas
      .map(
        (col, i) =>
          `<button type="button" role="tab" data-tab="${i}" aria-selected="${i === tab}" title="${esc(col.titulo)}">${esc(col.corto || col.titulo)}<span class="tab-n" data-tt="${esc(col.id)}"></span></button>`,
      )
      .join('');

    columnas.innerHTML = d.columnas
      .map(
        (col, i) => `
        <section class="card col-panel${i === tab ? ' active' : ''}" role="tabpanel" aria-label="${esc(col.titulo)}">
          <header class="col-head">
            <h2 title="${esc(col.titulo)}">${esc(col.titulo)}</h2>
            <span class="col-tot" data-tot="${esc(col.id)}"></span>
          </header>
          <ol class="filas">
            ${col.partidos.map((p, j) => fila(mesa, col.id, p.id, String(j + 1), p.nombre)).join('')}
          </ol>
          <ol class="filas especiales">
            ${fila(mesa, col.id, BLANCO, '', 'Votos en blanco')}
            ${fila(mesa, col.id, NULO, '', 'Votos nulos')}
          </ol>
        </section>`,
      )
      .join('');

    pintarEstado();
  }

  function fila(mesa: Mesa, col: string, p: string, num: string, nombre: string) {
    const v = votosDe(mesa, col, p);
    return `
      <li class="fila${v > 0 ? ' con-votos' : ''}" data-col="${esc(col)}" data-p="${esc(p)}">
        <span class="num">${num}</span>
        <span class="nombre" title="${esc(nombre)}">${esc(nombre)}</span>
        <span class="stepper">
          <button type="button" data-d="-1" tabindex="-1" aria-label="Restar un voto a ${esc(nombre)}">−</button>
          <input type="number" inputmode="numeric" enterkeyhint="next" min="0" step="1" value="${v}" aria-label="Votos de ${esc(nombre)}" />
          <button type="button" data-d="1" tabindex="-1" aria-label="Sumar un voto a ${esc(nombre)}">+</button>
        </span>
      </li>`;
  }

  /** Totales por columna, avisos y barra de estado de la mesa actual. */
  function pintarEstado(ok = true) {
    const { colegio, mesa } = actual();
    const lista = mesas(d);
    const i = lista.findIndex((u) => u.mesa.id === sel.m);
    anterior.disabled = i <= 0;
    siguiente.disabled = i < 0 || i >= lista.length - 1;

    const contadas = lista.filter((u) => mesaContada(d, u.mesa)).length;
    info.textContent = [
      colegio?.codigo && `Local ${colegio.codigo}`,
      mesa?.electores && `${fmt(mesa.electores)} electores`,
      i >= 0 && `Mesa ${i + 1}/${lista.length}`,
      lista.length && `${contadas} ${contadas === 1 ? 'contada' : 'contadas'}`,
    ]
      .filter(Boolean)
      .join(' · ');

    guardado.className = ok ? 'chip' : 'chip error';
    guardado.textContent = ok ? '✓ Guardado' : '⚠ No se pudo guardar';
    guardado.hidden = !mesa;
    chequeo.hidden = !mesa;
    if (!mesa) return;

    const totales = d.columnas.map((col) => ({ col, r: resumen(col, [mesa]) }));
    const ns = totales.map((t) => t.r.emitidos);
    const mayor = Math.max(0, ...ns);
    const faltan = totales.filter((t) => t.r.emitidos === 0);
    // Solo se avisa cuando todas las columnas tienen votos y no coinciden.
    const distintos = !faltan.length && new Set(ns).size > 1;

    for (const { col, r } of totales) {
      // Cada cédula cuenta en todas las columnas: se marcan las que tienen menos votos.
      const marcar = distintos && r.emitidos !== mayor;
      const tot = columnas.querySelector<HTMLElement>(`[data-tot="${CSS.escape(col.id)}"]`);
      if (tot) {
        tot.className = marcar ? 'col-tot warn' : 'col-tot';
        tot.innerHTML = `<b title="${fmt(r.validos)} válidos · ${fmt(r.emitidos)} emitidos">${fmt(r.emitidos)}</b>`;
      }
      const tt = tabs.querySelector<HTMLElement>(`[data-tt="${CSS.escape(col.id)}"]`);
      if (tt) {
        tt.className = marcar ? 'tab-n warn' : 'tab-n';
        tt.textContent = fmt(r.emitidos);
      }
    }

    if (mesa.electores && mayor > mesa.electores) {
      chequeo.className = 'chip error';
      chequeo.textContent = `⚠ Más votos que electores (${fmt(mayor)} de ${fmt(mesa.electores)})`;
    } else if (distintos) {
      chequeo.className = 'chip warn';
      chequeo.textContent = `⚠ Totales no coinciden (${ns.map(fmt).join(' · ')})`;
    } else if (mayor > 0 && faltan.length) {
      chequeo.className = 'chip';
      chequeo.textContent = `Falta: ${faltan.map((t) => t.col.corto || t.col.titulo).join(', ')}`;
    } else if (mayor > 0) {
      chequeo.className = 'chip ok';
      chequeo.textContent = '✓ Totales coinciden';
    } else {
      chequeo.className = 'chip';
      chequeo.textContent = 'Sin votos todavía';
    }
  }

  function cambiar(li: HTMLElement, n: number) {
    const { mesa } = actual();
    if (!mesa) return;
    ponerVotos(mesa, li.dataset.col!, li.dataset.p!, n);
    li.classList.toggle('con-votos', n > 0);
    pintarEstado(guardar(d));
  }

  function irA(paso: number) {
    const lista = mesas(d);
    const i = lista.findIndex((u) => u.mesa.id === sel.m);
    const destino = lista[i + paso];
    if (!destino) return;
    sel = { c: destino.colegio.id, a: destino.aula.id, m: destino.mesa.id };
    pintar();
  }

  selColegio.addEventListener('change', () => {
    sel = { c: selColegio.value, a: '', m: '' };
    pintar();
  });
  selAula.addEventListener('change', () => {
    sel = { ...sel, a: selAula.value, m: '' };
    pintar();
  });
  selMesa.addEventListener('change', () => {
    sel = { ...sel, m: selMesa.value };
    pintar();
  });
  anterior.addEventListener('click', () => irA(-1));
  siguiente.addEventListener('click', () => irA(1));

  tabs.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tab]');
    if (!b) return;
    tab = Number(b.dataset.tab);
    tabs.querySelectorAll('[data-tab]').forEach((x, i) => x.setAttribute('aria-selected', String(i === tab)));
    columnas.querySelectorAll('.col-panel').forEach((x, i) => x.classList.toggle('active', i === tab));
  });

  columnas.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-d]');
    const li = b?.closest<HTMLElement>('.fila');
    const input = li?.querySelector('input');
    if (!b || !li || !input) return;
    const n = Math.max(0, entero(input.value) + Number(b.dataset.d));
    input.value = String(n);
    cambiar(li, n);
  });

  columnas.addEventListener('input', (e) => {
    const input = e.target as HTMLInputElement;
    const li = input.closest<HTMLElement>('.fila');
    if (input.tagName === 'INPUT' && li) cambiar(li, entero(input.value));
  });

  // Al salir del campo, muestra el valor normalizado (sin negativos ni decimales).
  columnas.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.tagName === 'INPUT') input.value = String(entero(input.value));
  });

  columnas.addEventListener('focusin', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.tagName === 'INPUT') input.select();
  });

  // Enter pasa al siguiente partido, como al llenar el acta.
  columnas.addEventListener('keydown', (e) => {
    const input = e.target as HTMLInputElement;
    if (e.key !== 'Enter' || input.tagName !== 'INPUT') return;
    e.preventDefault();
    const visibles = [...columnas.querySelectorAll<HTMLInputElement>('input')].filter((x) => x.offsetParent);
    const sig = visibles[visibles.indexOf(input) + 1];
    if (sig) sig.focus();
    else input.blur();
  });

  pintar();
</script>
