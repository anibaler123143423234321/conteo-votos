---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Resultados">
  <div class="cabecera">
    <h1 id="alcance">Resultados</h1>
    <button type="button" class="btn" id="csv">Descargar CSV (Excel)</button>
  </div>

  <section class="card barra-sel" aria-label="Filtrar resultados">
    <div class="selectores sin-nav">
      <label class="campo campo-distrito">
        <span class="campo-et">Distrito</span>
        <select id="f-distrito"></select>
      </label>
      <label class="campo campo-colegio">
        <span class="campo-et">Colegio</span>
        <select id="f-colegio"></select>
      </label>
      <label class="campo campo-aula">
        <span class="campo-et">Aula</span>
        <select id="f-aula"></select>
      </label>
      <label class="campo campo-mesa">
        <span class="campo-et">Mesa</span>
        <select id="f-mesa"></select>
      </label>
    </div>
    <div class="estado-mesa">
      <span class="info" id="progreso"></span>
      <span class="chip" id="avance"></span>
    </div>
  </section>

  <div class="tabs" id="tabs" role="tablist" aria-label="Columnas de la cédula"></div>

  <!-- Dashboard de Gráficos de Resultados (Chart.js) -->
  <section class="dash-card" id="dash-resultados" aria-label="Dashboard visual de resultados">
    <div class="dash-cab">
      <div class="dash-titulo-wrap">
        <span class="dash-badge ok" id="dash-badge-estado">En vivo</span>
        <h2 class="dash-titulo" id="dash-columna-titulo">Resultados</h2>
      </div>
      <div class="dash-meta" id="dash-alcance-meta">Provincia de Ferreñafe</div>
    </div>

    <!-- Selector de columna para gráficos (visible en móvil y escritorio) -->
    <div class="dash-pills-bar" id="dash-pills" role="tablist" aria-label="Elegir columna de la cédula para los gráficos"></div>

    <div class="dash-kpis">
      <div class="dash-kpi">
        <span class="dash-kpi-et">Agrupación Líder</span>
        <div class="dash-kpi-val" id="dash-kpi-lider">-</div>
        <span class="dash-kpi-sub" id="dash-kpi-lider-sub">Esperando votos</span>
      </div>
      <div class="dash-kpi">
        <span class="dash-kpi-et">Votos Válidos</span>
        <div class="dash-kpi-val" id="dash-kpi-validos">0</div>
        <span class="dash-kpi-sub" id="dash-kpi-validos-sub">0% del total</span>
      </div>
      <div class="dash-kpi">
        <span class="dash-kpi-et">Blancos y Nulos</span>
        <div class="dash-kpi-val" id="dash-kpi-viciados">0</div>
        <span class="dash-kpi-sub" id="dash-kpi-viciados-sub">0% del total</span>
      </div>
      <div class="dash-kpi">
        <span class="dash-kpi-et">Mesas Computadas</span>
        <div class="dash-kpi-val" id="dash-kpi-mesas">0 / 0</div>
        <span class="dash-kpi-sub" id="dash-kpi-mesas-sub">0% escrutado</span>
      </div>
    </div>

    <div class="dash-graficos">
      <!-- Gráfico de Barras: Votos por Partido -->
      <div class="dash-grafico-card">
        <div class="dash-grafico-cab">
          <h3 class="dash-grafico-titulo">Votos por Agrupación Política</h3>
          <span class="dash-grafico-tag" id="dash-tag-partidos">Ordenado por votos</span>
        </div>
        <div class="dash-canvas-wrap">
          <canvas id="chart-res-barras"></canvas>
          <div class="dash-empty" id="empty-res-barras" hidden>
            <div class="dash-empty-icon">📊</div>
            <div>Aún no se registran votos para esta columna en el filtro seleccionado.</div>
          </div>
        </div>
      </div>

      <!-- Gráfico de Dona: Distribución Válidos / Blancos / Nulos -->
      <div class="dash-grafico-card">
        <div class="dash-grafico-cab">
          <h3 class="dash-grafico-titulo">Composición de Votos Emitidos</h3>
          <span class="dash-grafico-tag">Distribución general</span>
        </div>
        <div class="dash-canvas-wrap dona-wrap">
          <canvas id="chart-res-donut"></canvas>
          <div class="dash-empty" id="empty-res-donut" hidden>
            <div class="dash-empty-icon">🗳️</div>
            <div>Sin votos emitidos aún.</div>
          </div>
        </div>
        <div class="dash-donut-legend" id="donut-res-leyenda"></div>
      </div>
    </div>
  </section>

  <div class="columnas" id="resultados"></div>

  <section class="card" id="por-distrito" aria-labelledby="por-distrito-titulo" hidden>
    <div class="card-cab">
      <h2 class="card-titulo" id="por-distrito-titulo">Total por distrito</h2>
      <div class="segmentos" id="seg-columna" role="group" aria-label="Columna de la cédula"></div>
    </div>
    <div class="matriz-wrap">
      <table class="tabla-res matriz" id="matriz"></table>
    </div>
    <p class="nota">
      <span class="solo-movil">Desliza la tabla hacia los lados para ver todos los distritos. </span>Toca el nombre
      de un distrito para ver solo su total, con porcentajes.
    </p>
  </section>
</AdminLayout>

<script>
  import Chart from 'chart.js/auto';
  import {
    BLANCO,
    NULO,
    cargar,
    columnasDe,
    descargar,
    electoresDe,
    esc,
    fmt,
    mesaContada,
    mesas,
    nombreColegio,
    opciones,
    pct,
    resumen,
    votosDe,
    type Aula,
    type Colegio,
    type Columna,
    type Datos,
    type Distrito,
    type Mesa,
    type Resumen,
  } from '../../lib/store';
  import { conectar } from '../../lib/nube';

  const d: Datos = cargar();
  // Se puede abrir filtrado: /admin/resultados?distrito=<id> (así llega desde el conteo).
  const pedido = new URLSearchParams(location.search);
  let f = {
    distrito: pedido.get('distrito') ?? '',
    colegio: pedido.get('colegio') ?? '',
    aula: pedido.get('aula') ?? '',
    mesa: pedido.get('mesa') ?? '',
  };
  let tab = 0;
  /** Columna que muestra la tabla "Total por distrito". */
  let colMatriz = 0;

  const PALETA_PARTIDOS = [
    '#2563eb', '#0d9488', '#7c3aed', '#ea580c', '#0284c7',
    '#db2777', '#16a34a', '#ca8a04', '#9333ea', '#0891b2',
    '#e11d48', '#4f46e5', '#059669', '#d97706', '#475569',
  ];

  let chartBarras: Chart | null = null;
  let chartDonut: Chart | null = null;
  let ultimosResumenes: Resumen[] = [];
  let ultimasCols: Columna[] = [];
  let ultimasMesas: Mesa[] = [];
  let ultimasContadas = 0;

  function coloresTema() {
    const isDark = document.documentElement.dataset.theme === 'dark';
    return {
      isDark,
      textColor: isDark ? '#e8ebf1' : '#101828',
      mutedColor: isDark ? '#a0a9ba' : '#5d6679',
      gridColor: isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(16, 24, 40, 0.07)',
      borderColor: isDark ? '#222938' : '#e4e7ec',
      surface: isDark ? '#161b26' : '#ffffff',
      tooltipBg: isDark ? '#1d2331' : '#ffffff',
      tooltipBorder: isDark ? '#2c3446' : '#d0d5dd',
    };
  }

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const fDistrito = $<HTMLSelectElement>('f-distrito');
  const fColegio = $<HTMLSelectElement>('f-colegio');
  const fAula = $<HTMLSelectElement>('f-aula');
  const fMesa = $<HTMLSelectElement>('f-mesa');
  const tabs = $('tabs');
  const cont = $('resultados');
  const porDistrito = $('por-distrito');
  const segColumna = $('seg-columna');
  const matriz = $('matriz');

  /** Qué se está sumando, dicho con todas las letras. */
  function alcance(distrito?: Distrito, colegio?: Colegio, aula?: Aula, mesa?: Mesa) {
    if (mesa) return `Mesa ${mesa.numero}`;
    if (aula) return /^aula\b/i.test(aula.nombre) ? `Total del ${aula.nombre}` : `Total del aula ${aula.nombre}`;
    if (distrito && colegio) return `Total del colegio ${nombreColegio(distrito.colegios, colegio)}`;
    if (distrito) return `Total del distrito de ${distrito.nombre}`;
    return `Total de la provincia de ${d.provincia || 'Ferreñafe'}`;
  }

  /** Deja el filtro en la dirección, para poder compartir o recargar esa vista. */
  function recordarFiltro() {
    const q = new URLSearchParams();
    for (const [k, v] of Object.entries(f)) if (v) q.set(k, v);
    const texto = q.toString();
    history.replaceState(null, '', texto ? `?${texto}` : location.pathname);
  }

  /** Tabla con una columna por distrito y el total de la provincia (solo sin distrito elegido). */
  function pintarPorDistrito(visible: boolean) {
    const compartidas = d.columnas.filter((c) => !c.distrito);
    porDistrito.hidden = !visible || !compartidas.length || !d.distritos.length;
    if (porDistrito.hidden) return;
    if (colMatriz >= compartidas.length) colMatriz = 0;
    const col = compartidas[colMatriz];

    segColumna.innerHTML = compartidas
      .map(
        (c, i) =>
          `<button type="button" data-col="${i}" aria-pressed="${i === colMatriz}" title="${esc(c.titulo)}">${esc(c.corto || c.titulo)}</button>`,
      )
      .join('');

    const grupo = (lista: Mesa[]) => ({
      lista,
      r: resumen(col, lista),
      contadas: lista.filter((m) => mesaContada(d, m)).length,
    });
    const distritos = d.distritos.map((x) => ({ x, ...grupo(mesas(d, { distrito: x.id }).map((u) => u.mesa)) }));
    const total = grupo(distritos.flatMap((g) => g.lista));
    // El total va primero: en celular se ve sin deslizar la tabla.
    const grupos = [total, ...distritos];
    // El que va primero en cada distrito (y en el total) se resalta.
    const primeros = grupos.map((g) => Math.max(0, ...g.r.filas.map((x) => x.votos)));
    const orden = total.r.filas.map((x, i) => ({ ...x, i })).sort((a, b) => b.votos - a.votos || a.i - b.i);
    const celda = (n: number, k: number, lider = false) =>
      `<td class="n${k === 0 ? ' col-total' : ''}${lider ? ' lider' : ''}">${fmt(n)}</td>`;
    const fila = (titulo: string, valor: (g: (typeof grupos)[number]) => number, clase = '') =>
      `<tr${clase ? ` class="${clase}"` : ''}><th>${titulo}</th>${grupos.map((g, k) => celda(valor(g), k)).join('')}</tr>`;

    matriz.innerHTML = `
      <thead>
        <tr>
          <th>Partido</th>
          <th class="n col-total">Total</th>
          ${distritos
            .map(
              (g) =>
                `<th class="n"><button type="button" data-distrito="${esc(g.x.id)}" title="Ver el total del distrito de ${esc(g.x.nombre)}">${esc(g.x.corto ?? g.x.nombre)}</button></th>`,
            )
            .join('')}
        </tr>
      </thead>
      <tbody>
        ${orden
          .map(
            (x) =>
              `<tr><td class="partido">${esc(x.partido.nombre)}</td>${grupos
                .map((g, k) => {
                  const v = g.r.filas[x.i].votos;
                  return celda(v, k, v > 0 && v === primeros[k]);
                })
                .join('')}</tr>`,
          )
          .join('')}
      </tbody>
      <tfoot>
        ${fila('Votos válidos', (g) => g.r.validos)}
        ${fila('Votos en blanco', (g) => g.r.blanco)}
        ${fila('Votos nulos', (g) => g.r.nulo)}
        ${fila('Total emitidos', (g) => g.r.emitidos, 'total')}
        <tr class="mesas"><th>Mesas contadas</th>${grupos
          .map((g, k) => `<td class="n${k === 0 ? ' col-total' : ''}">${fmt(g.contadas)}/${fmt(g.lista.length)}</td>`)
          .join('')}</tr>
      </tfoot>`;
  }

  function actualizarDashboard() {
    if (!ultimosResumenes.length || tab >= ultimosResumenes.length) return;
    const r = ultimosResumenes[tab];
    const col = ultimasCols[tab];
    if (!r || !col) return;
    const c = coloresTema();

    // Actualizar encabezado
    $('dash-columna-titulo').textContent = col.titulo;
    const distritoAct = d.distritos.find((x) => x.id === f.distrito);
    const colegioAct = distritoAct?.colegios.find((x) => x.id === f.colegio);
    const aulaAct = colegioAct?.aulas.find((x) => x.id === f.aula);
    const mesaAct = aulaAct?.mesas.find((x) => x.id === f.mesa);
    $('dash-alcance-meta').textContent = alcance(distritoAct, colegioAct, aulaAct, mesaAct);

    // Ordenar partidos por votos
    const filas = [...r.filas].sort((a, b) => b.votos - a.votos);
    const max = filas[0]?.votos ?? 0;
    const segundo = filas[1]?.votos ?? 0;
    const liderEl = $('dash-kpi-lider');
    const liderSubEl = $('dash-kpi-lider-sub');

    if (max > 0 && filas[0]) {
      liderEl.textContent = filas[0].partido.nombre;
      const ventaja = max - segundo;
      liderSubEl.textContent =
        ventaja > 0
          ? `+${fmt(ventaja)} votos de ventaja (${pct(max, r.validos)} válidos)`
          : `Empate con ${fmt(max)} votos (${pct(max, r.validos)})`;
    } else {
      liderEl.textContent = 'Sin votos';
      liderSubEl.textContent = 'Esperando escrutinio';
    }

    $('dash-kpi-validos').textContent = fmt(r.validos);
    $('dash-kpi-validos-sub').textContent = r.emitidos ? `${pct(r.validos, r.emitidos)} del total` : '0% del total';

    const viciados = r.blanco + r.nulo;
    $('dash-kpi-viciados').textContent = fmt(viciados);
    $('dash-kpi-viciados-sub').textContent = r.emitidos ? `${pct(viciados, r.emitidos)} del total` : '0% del total';

    $('dash-kpi-mesas').textContent = `${fmt(ultimasContadas)} / ${fmt(ultimasMesas.length)}`;
    $('dash-kpi-mesas-sub').textContent = `${pct(ultimasContadas, ultimasMesas.length)} procesadas`;

    // --- Gráfico de Barras ---
    const canvasBarras = $<HTMLCanvasElement>('chart-res-barras');
    const emptyBarras = $('empty-res-barras');

    if (!filas.length) {
      emptyBarras.hidden = false;
      canvasBarras.style.display = 'none';
      if (chartBarras) {
        chartBarras.destroy();
        chartBarras = null;
      }
    } else {
      emptyBarras.hidden = true;
      canvasBarras.style.display = 'block';

      const labels = filas.map((x) => x.partido.nombre);
      const dataVotos = filas.map((x) => x.votos);
      const bgColors = filas.map((_, i) => PALETA_PARTIDOS[i % PALETA_PARTIDOS.length]);

      if (chartBarras) {
        chartBarras.data.labels = labels;
        chartBarras.data.datasets[0].data = dataVotos;
        chartBarras.data.datasets[0].backgroundColor = bgColors;
        chartBarras.options.scales!.x!.grid!.color = c.gridColor;
        chartBarras.options.scales!.x!.ticks!.color = c.mutedColor;
        chartBarras.options.scales!.y!.ticks!.color = c.textColor;
        chartBarras.options.plugins!.tooltip!.backgroundColor = c.tooltipBg;
        chartBarras.options.plugins!.tooltip!.titleColor = c.textColor;
        chartBarras.options.plugins!.tooltip!.bodyColor = c.textColor;
        chartBarras.options.plugins!.tooltip!.borderColor = c.tooltipBorder;
        chartBarras.update();
      } else {
        chartBarras = new Chart(canvasBarras, {
          type: 'bar',
          data: {
            labels,
            datasets: [
              {
                label: 'Votos',
                data: dataVotos,
                backgroundColor: bgColors,
                borderRadius: 6,
                borderSkipped: false,
                barThickness: filas.length > 8 ? 16 : 22,
              },
            ],
          },
          options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            animation: { duration: 350 },
            plugins: {
              legend: { display: false },
              tooltip: {
                backgroundColor: c.tooltipBg,
                titleColor: c.textColor,
                bodyColor: c.textColor,
                borderColor: c.tooltipBorder,
                borderWidth: 1,
                padding: 10,
                boxPadding: 4,
                callbacks: {
                  label: (ctx) => {
                    const val = ctx.raw as number;
                    return ` ${fmt(val)} votos (${pct(val, r.validos)} de válidos)`;
                  },
                },
              },
            },
            scales: {
              x: {
                beginAtZero: true,
                grid: { color: c.gridColor },
                ticks: {
                  color: c.mutedColor,
                  font: { family: 'inherit', size: 11 },
                  precision: 0,
                },
              },
              y: {
                grid: { display: false },
                ticks: {
                  color: c.textColor,
                  font: { family: 'inherit', weight: 600, size: 12 },
                  callback: function (_val, index) {
                    const nombre = labels[index] || '';
                    return nombre.length > 24 ? nombre.slice(0, 22) + '…' : nombre;
                  },
                },
              },
            },
          },
        });
      }
    }

    // --- Gráfico de Dona ---
    const canvasDonut = $<HTMLCanvasElement>('chart-res-donut');
    const emptyDonut = $('empty-res-donut');
    const donutLeyenda = $('donut-res-leyenda');

    emptyDonut.hidden = true;
    canvasDonut.style.display = 'block';

    const donutData = r.emitidos > 0 ? [r.validos, r.blanco, r.nulo] : [1];
    const donutLabels = r.emitidos > 0 ? ['Votos Válidos', 'Votos en Blanco', 'Votos Nulos'] : ['Esperando escrutinio'];
    const donutColors = r.emitidos > 0 ? ['#2563eb', '#94a3b8', '#ef4444'] : [c.isDark ? '#2c3446' : '#e2e8f0'];

    if (chartDonut) {
      chartDonut.data.labels = donutLabels;
      chartDonut.data.datasets[0].data = donutData;
      chartDonut.data.datasets[0].backgroundColor = donutColors;
      chartDonut.data.datasets[0].borderColor = c.surface;
      chartDonut.options.plugins!.tooltip!.backgroundColor = c.tooltipBg;
      chartDonut.options.plugins!.tooltip!.titleColor = c.textColor;
      chartDonut.options.plugins!.tooltip!.bodyColor = c.textColor;
      chartDonut.options.plugins!.tooltip!.borderColor = c.tooltipBorder;
      chartDonut.update();
    } else {
      chartDonut = new Chart(canvasDonut, {
        type: 'doughnut',
        data: {
          labels: donutLabels,
          datasets: [
            {
              data: donutData,
              backgroundColor: donutColors,
              borderColor: c.surface,
              borderWidth: 2,
              hoverOffset: r.emitidos > 0 ? 6 : 0,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '68%',
          animation: { duration: 350 },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: c.tooltipBg,
              titleColor: c.textColor,
              bodyColor: c.textColor,
              borderColor: c.tooltipBorder,
              borderWidth: 1,
              padding: 10,
              callbacks: {
                label: (ctx) => {
                  if (r.emitidos === 0) return ' Esperando ingreso de votos';
                  const val = ctx.raw as number;
                  return ` ${fmt(val)} votos (${pct(val, r.emitidos)} del total)`;
                },
              },
            },
          },
        },
      });
    }

    if (r.emitidos > 0) {
      donutLeyenda.innerHTML = `
        <div class="dash-legend-item">
          <span class="dash-legend-dot" style="background:${donutColors[0]}"></span>
          <span>Válidos:</span>
          <span class="dash-legend-val">${fmt(r.validos)} (${pct(r.validos, r.emitidos)})</span>
        </div>
        <div class="dash-legend-item">
          <span class="dash-legend-dot" style="background:${donutColors[1]}"></span>
          <span>Blanco:</span>
          <span class="dash-legend-val">${fmt(r.blanco)} (${pct(r.blanco, r.emitidos)})</span>
        </div>
        <div class="dash-legend-item">
          <span class="dash-legend-dot" style="background:${donutColors[2]}"></span>
          <span>Nulos:</span>
          <span class="dash-legend-val">${fmt(r.nulo)} (${pct(r.nulo, r.emitidos)})</span>
        </div>
      `;
    } else {
      donutLeyenda.innerHTML = `
        <div class="dash-legend-item">
          <span class="dash-legend-dot" style="background:#94a3b8"></span>
          <span>Esperando inicio de escrutinio en este filtro (0 emitidos)</span>
        </div>
      `;
    }
  }

  function pintar() {
    const distrito = d.distritos.find((x) => x.id === f.distrito);
    const colegio = distrito?.colegios.find((x) => x.id === f.colegio);
    const aula = colegio?.aulas.find((x) => x.id === f.aula);
    const mesa = aula?.mesas.find((x) => x.id === f.mesa);
    f = { distrito: distrito?.id ?? '', colegio: colegio?.id ?? '', aula: aula?.id ?? '', mesa: mesa?.id ?? '' };
    $('alcance').textContent = alcance(distrito, colegio, aula, mesa);
    recordarFiltro();

    opciones(
      fDistrito,
      [{ id: '', nombre: 'Toda la provincia' }, ...d.distritos.map((x) => ({ id: x.id, nombre: x.corto ?? x.nombre }))],
      f.distrito,
    );
    opciones(
      fColegio,
      [
        { id: '', nombre: 'Todos' },
        ...(distrito?.colegios ?? []).map((c) => ({ id: c.id, nombre: nombreColegio(distrito!.colegios, c) })),
      ],
      f.colegio,
    );
    fColegio.disabled = !distrito;
    opciones(fAula, [{ id: '', nombre: 'Todas' }, ...(colegio?.aulas ?? [])], f.aula);
    opciones(
      fMesa,
      [{ id: '', nombre: 'Todas' }, ...(aula?.mesas ?? []).map((m) => ({ id: m.id, nombre: m.numero }))],
      f.mesa,
    );
    fAula.disabled = !colegio;
    fMesa.disabled = !aula;

    const lista = mesas(d, f).map((u) => u.mesa);
    const conVotos = lista.filter((m) => mesaContada(d, m));
    const contadas = conVotos.length;
    const electores = electoresDe(lista);
    // La participación solo se compara con los electores de las mesas ya contadas.
    const electoresContadas = electoresDe(conVotos);
    $('progreso').textContent =
      `${fmt(lista.length)} mesas` + (electores ? ` · ${fmt(electores)} electores hábiles` : '');
    const avance = $('avance');
    avance.textContent = `${fmt(contadas)} de ${fmt(lista.length)} mesas contadas (${pct(contadas, lista.length)})`;
    avance.className = lista.length && contadas === lista.length ? 'chip ok' : 'chip';

    // Con toda la provincia solo se suman las columnas que comparten todos los distritos.
    const cols = distrito ? columnasDe(d, distrito.id) : d.columnas.filter((c) => !c.distrito);
    if (tab >= cols.length) tab = 0;
    cont.style.setProperty('--cols', String(cols.length));
    cont.classList.toggle('cuatro', cols.length > 3);
    const resumenes = cols.map((col) => resumen(col, lista));

    tabs.innerHTML = resumenes
      .map(
        (r, i) =>
          `<button type="button" role="tab" data-tab="${i}" aria-selected="${i === tab}" title="${esc(r.columna.titulo)}"><span class="tab-et">${esc(r.columna.corto || r.columna.titulo)}</span><span class="tab-n">${fmt(r.emitidos)}</span></button>`,
      )
      .join('');

    const dashPills = $('dash-pills');
    if (dashPills) {
      dashPills.innerHTML = resumenes
        .map(
          (r, i) =>
            `<button type="button" class="dash-pill-btn" data-pill="${i}" aria-selected="${i === tab}">
              <span>${esc(r.columna.corto || r.columna.titulo)}</span>
              <span class="pill-n">${fmt(r.emitidos)}</span>
            </button>`,
        )
        .join('');
    }

    cont.innerHTML = resumenes
      .map((r, i) => {
        const filas = [...r.filas].sort((a, b) => b.votos - a.votos);
        const max = filas[0]?.votos ?? 0;
        return `
        <section class="card col-panel${i === tab ? ' active' : ''}" role="tabpanel" aria-label="${esc(r.columna.titulo)}">
          <header class="col-head">
            <h2 title="${esc(r.columna.titulo)}">${esc(r.columna.titulo)}</h2>
            <span class="col-tot"><b title="${fmt(r.validos)} válidos · ${fmt(r.emitidos)} emitidos">${fmt(r.emitidos)}</b></span>
          </header>
          <table class="tabla-res">
            <thead><tr><th>Partido</th><th class="n">Votos</th><th class="n">%</th></tr></thead>
            <tbody>
              ${filas.length ? '' : '<tr><td colspan="3" class="muted">Todavía no hay partidos en esta columna.</td></tr>'}
              ${filas
                .map(
                  (x) => `
                <tr class="${max > 0 && x.votos === max ? 'lider' : ''}">
                  <td class="partido"><div class="barra" style="--p:${max ? ((x.votos / max) * 100).toFixed(1) : 0}%"><span>${esc(x.partido.nombre)}</span></div></td>
                  <td class="n">${fmt(x.votos)}</td>
                  <td class="n">${pct(x.votos, r.validos)}</td>
                </tr>`,
                )
                .join('')}
            </tbody>
            <tfoot>
              <tr><th>Votos válidos</th><td class="n">${fmt(r.validos)}</td><td class="n">${pct(r.validos, r.emitidos)}</td></tr>
              <tr><th>Votos en blanco</th><td class="n">${fmt(r.blanco)}</td><td class="n">${pct(r.blanco, r.emitidos)}</td></tr>
              <tr><th>Votos nulos</th><td class="n">${fmt(r.nulo)}</td><td class="n">${pct(r.nulo, r.emitidos)}</td></tr>
              <tr class="total"><th>Total emitidos</th><td class="n">${fmt(r.emitidos)}</td><td class="n">${electoresContadas ? pct(r.emitidos, electoresContadas) : ''}</td></tr>
            </tfoot>
          </table>
          <p class="nota">% de partidos sobre votos válidos; válidos, blanco y nulos sobre emitidos${electoresContadas ? '; total sobre electores de las mesas contadas' : ''}.</p>
        </section>`;
      })
      .join('');

    ultimasCols = cols;
    ultimosResumenes = resumenes;
    ultimasMesas = lista;
    ultimasContadas = contadas;
    actualizarDashboard();

    pintarPorDistrito(!distrito);
  }

  fDistrito.addEventListener('change', () => {
    f = { distrito: fDistrito.value, colegio: '', aula: '', mesa: '' };
    pintar();
  });
  fColegio.addEventListener('change', () => {
    f = { ...f, colegio: fColegio.value, aula: '', mesa: '' };
    pintar();
  });
  fAula.addEventListener('change', () => {
    f = { ...f, aula: fAula.value, mesa: '' };
    pintar();
  });
  fMesa.addEventListener('change', () => {
    f = { ...f, mesa: fMesa.value };
    pintar();
  });

  segColumna.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-col]');
    if (!b) return;
    colMatriz = Number(b.dataset.col);
    pintarPorDistrito(true);
  });

  matriz.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-distrito]');
    if (!b) return;
    f = { distrito: b.dataset.distrito ?? '', colegio: '', aula: '', mesa: '' };
    pintar();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  tabs.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-tab]');
    if (!b) return;
    tab = Number(b.dataset.tab);
    tabs.querySelectorAll('[data-tab]').forEach((x, i) => x.setAttribute('aria-selected', String(i === tab)));
    const dashPills = $('dash-pills');
    if (dashPills) {
      dashPills.querySelectorAll('[data-pill]').forEach((x, i) => x.setAttribute('aria-selected', String(i === tab)));
    }
    cont.querySelectorAll('.col-panel').forEach((x, i) => x.classList.toggle('active', i === tab));
    actualizarDashboard();
  });

  const dashPills = $('dash-pills');
  if (dashPills) {
    dashPills.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-pill]');
      if (!b) return;
      tab = Number(b.dataset.pill);
      dashPills.querySelectorAll('[data-pill]').forEach((x, i) => x.setAttribute('aria-selected', String(i === tab)));
      tabs.querySelectorAll('[data-tab]').forEach((x, i) => x.setAttribute('aria-selected', String(i === tab)));
      cont.querySelectorAll('.col-panel').forEach((x, i) => x.classList.toggle('active', i === tab));
      actualizarDashboard();
    });
  }

  // Observador para cambios de modo oscuro / claro
  const obsTema = new MutationObserver(() => {
    actualizarDashboard();
  });
  obsTema.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  const hoy = () => new Date().toISOString().slice(0, 10);

  $('csv').addEventListener('click', () => {
    const filas = [
      ['Distrito', 'Local ONPE', 'Colegio', 'Aula', 'Mesa', 'Electores hábiles', 'Columna', 'N°', 'Partido', 'Votos'],
    ];
    for (const { distrito, colegio, aula, mesa } of mesas(d)) {
      const base = [
        distrito.nombre,
        colegio.codigo ?? '',
        colegio.nombre,
        aula.nombre,
        mesa.numero,
        mesa.electores ? String(mesa.electores) : '',
      ];
      for (const col of columnasDe(d, distrito.id)) {
        col.partidos.forEach((p, i) =>
          filas.push([...base, col.titulo, String(i + 1), p.nombre, String(votosDe(mesa, col.id, p.id))]),
        );
        filas.push([...base, col.titulo, '', 'VOTOS EN BLANCO', String(votosDe(mesa, col.id, BLANCO))]);
        filas.push([...base, col.titulo, '', 'VOTOS NULOS', String(votosDe(mesa, col.id, NULO))]);
      }
    }
    const celda = (c: string) => (/[",\n\r]/.test(c) ? `"${c.replace(/"/g, '""')}"` : c);
    const texto = filas.map((r) => r.map(celda).join(',')).join('\r\n');
    descargar(`conteo-votos-${hoy()}.csv`, '﻿' + texto, 'text/csv;charset=utf-8');
  });

  pintar();
  conectar(d, pintar, { enVivo: true });
</script>
