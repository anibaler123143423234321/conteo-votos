---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Resumen">
  <div class="cabecera">
    <h1>Resumen</h1>
    <span class="muted">Provincia de Ferreñafe · Elecciones Regionales y Municipales 2026</span>
  </div>

  <section class="card datos" id="nube-vacia" hidden>
    <p>
      <strong>La base de datos de Supabase está vacía.</strong> Sube los datos de este navegador
      (colegios, mesas, partidos y votos) para que todos trabajen con la misma información.
    </p>
    <button type="button" class="btn primary" id="sembrar">Subir datos a Supabase</button>
  </section>

  <div class="kpis" id="kpis"></div>

  <!-- Dashboard General de Escrutinio Provincial (Chart.js) -->
  <section class="dash-card" id="dash-resumen" aria-label="Dashboard general de escrutinio">
    <div class="dash-cab">
      <div class="dash-titulo-wrap">
        <span class="dash-badge ok" id="resumen-badge">Provincia en Directo</span>
        <h2 class="dash-titulo">Estado y Avance General del Escrutinio</h2>
      </div>
      <div class="dash-meta" id="resumen-chart-meta">Ferreñafe · 6 Distritos</div>
    </div>

    <!-- Mini KPIs destacados de avance -->
    <div class="dash-kpis">
      <div class="dash-kpi">
        <span class="dash-kpi-et">Escrutinio Provincial</span>
        <div class="dash-kpi-val" id="kpi-pct-avance">0%</div>
        <span class="dash-kpi-sub" id="kpi-mesas-detalle">0 de 0 mesas</span>
      </div>
      <div class="dash-kpi">
        <span class="dash-kpi-et">Votos Computados</span>
        <div class="dash-kpi-val" id="kpi-votos-totales">0</div>
        <span class="dash-kpi-sub" id="kpi-votos-sub">En mesas procesadas</span>
      </div>
      <div class="dash-kpi">
        <span class="dash-kpi-et">Participación Estimada</span>
        <div class="dash-kpi-val" id="kpi-participacion">0%</div>
        <span class="dash-kpi-sub" id="kpi-electores-sub">Sobre electores hábiles</span>
      </div>
      <div class="dash-kpi">
        <span class="dash-kpi-et">Mesas Pendientes</span>
        <div class="dash-kpi-val" id="kpi-mesas-pendientes">0</div>
        <span class="dash-kpi-sub" id="kpi-pendientes-sub">Por procesar</span>
      </div>
    </div>

    <!-- Gráficos interactivos Chart.js -->
    <div class="dash-graficos">
      <!-- Gráfico 1: Barras de Avance por Distrito -->
      <div class="dash-grafico-card">
        <div class="dash-grafico-cab">
          <h3 class="dash-grafico-titulo">Avance de Escrutinio por Distrito</h3>
          <span class="dash-grafico-tag">% de mesas procesadas</span>
        </div>
        <div class="dash-canvas-wrap">
          <canvas id="chart-resumen-distritos"></canvas>
        </div>
      </div>

      <!-- Gráfico 2: Dona de Estado General de Mesas -->
      <div class="dash-grafico-card">
        <div class="dash-grafico-cab">
          <h3 class="dash-grafico-titulo">Distribución de Mesas Provincial</h3>
          <span class="dash-grafico-tag">Total de la provincia</span>
        </div>
        <div class="dash-canvas-wrap dona-wrap">
          <canvas id="chart-resumen-mesas"></canvas>
        </div>
        <div class="dash-donut-legend" id="resumen-donut-leyenda"></div>
      </div>
    </div>
  </section>

  <section class="card">
    <h2 class="card-titulo">Avance por distrito</h2>
    <div class="tabla-wrap">
      <table class="tabla">
        <thead>
          <tr>
            <th>Distrito</th>
            <th class="n">Colegios</th>
            <th class="n">Mesas</th>
            <th class="n">Contadas</th>
            <th>Avance</th>
            <th>N° de mesa</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="avance"></tbody>
      </table>
    </div>
  </section>

  <section class="card datos">
    <p id="texto-datos">
      Todo se guarda en este navegador. Descarga un respaldo de vez en cuando para no perder el
      conteo o para pasarlo a otra computadora.
    </p>
    <div class="acciones">
      <button type="button" class="btn" id="json">Descargar respaldo</button>
      <button type="button" class="btn" id="importar">Cargar respaldo</button>
      <input type="file" id="archivo" accept=".json,application/json" hidden />
      <button type="button" class="btn danger" id="borrar-votos">Borrar votos</button>
      <button type="button" class="btn danger" id="borrar-todo">Borrar todo</button>
    </div>
  </section>
</AdminLayout>

<script>
  import Chart from 'chart.js/auto';
  import {
    cargar,
    datosIniciales,
    descargar,
    electoresDe,
    esDatos,
    esc,
    fmt,
    guardar,
    mesaContada,
    mesas,
    normalizar,
    pct,
    resumen,
    type Datos,
  } from '../../lib/store';
  import { alEstado, conectar, nubeActiva, sembrar } from '../../lib/nube';

  const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
  const d: Datos = cargar();
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const archivo = $<HTMLInputElement>('archivo');

  const porcentaje = (n: number, total: number) => (total ? (n / total) * 100 : 0);
  // Con Supabase, borrar o cargar un respaldo cambia los datos de todos.
  const paraTodos = nubeActiva ? ' Se cambia en Supabase, para todos los que usan la web.' : '';
  if (nubeActiva) {
    $('texto-datos').textContent =
      'Los datos están en Supabase y cada navegador guarda una copia. Descarga un respaldo de vez en cuando.';
  }

  let chartDistritos: Chart | null = null;
  let chartMesas: Chart | null = null;
  // Datos del avance por distrito que lee el texto del gráfico (se actualiza en cada repintado:
  // si leyera los del momento en que se creó el gráfico, quedarían viejos).
  let avanceDistritos: { pctTexto: string; contadas: number; total: number }[] = [];

  function coloresTema() {
    const isDark = document.documentElement.dataset.theme === 'dark';
    return {
      isDark,
      textColor: isDark ? '#e8ebf1' : '#101828',
      mutedColor: isDark ? '#a0a9ba' : '#5d6679',
      gridColor: isDark ? 'rgba(255, 255, 255, 0.08)' : 'rgba(16, 24, 40, 0.07)',
      borderColor: isDark ? '#222938' : '#e4e7ec',
      surface: isDark ? '#161b26' : '#ffffff',
      tooltipBg: isDark ? '#1d2331' : '#ffffff',
      tooltipBorder: isDark ? '#2c3446' : '#d0d5dd',
    };
  }

  function actualizarDashboardResumen() {
    const todas = mesas(d);
    const contadas = todas.filter((u) => mesaContada(d, u.mesa)).length;
    const pendientes = todas.length - contadas;
    const c = coloresTema();

    // Sumar votos computados en la primera columna compartida (Gobernador / Provincial)
    const colBase = d.columnas.find((col) => !col.distrito) || d.columnas[0];
    const resumenBase = colBase ? resumen(colBase, todas.map((u) => u.mesa)) : null;
    const votosTotales = resumenBase ? resumenBase.emitidos : 0;

    // Electores hábiles en mesas procesadas
    const mesasConVotos = todas.filter((u) => mesaContada(d, u.mesa)).map((u) => u.mesa);
    const electoresProcesados = electoresDe(mesasConVotos);
    const electoresTotales = electoresDe(todas.map((u) => u.mesa));

    // KPI 1: Escrutinio Provincial
    $('kpi-pct-avance').textContent = pct(contadas, todas.length);
    $('kpi-mesas-detalle').textContent = `${fmt(contadas)} de ${fmt(todas.length)} mesas`;

    // KPI 2: Votos Computados
    $('kpi-votos-totales').textContent = fmt(votosTotales);
    $('kpi-votos-sub').textContent = colBase ? `En ${colBase.corto || colBase.titulo}` : 'Votos computados';

    // KPI 3: Participación Estimada
    if (electoresProcesados > 0 && votosTotales > 0) {
      $('kpi-participacion').textContent = pct(votosTotales, electoresProcesados);
      $('kpi-electores-sub').textContent = `${fmt(votosTotales)} de ${fmt(electoresProcesados)} electores`;
    } else {
      $('kpi-participacion').textContent = '—';
      $('kpi-electores-sub').textContent = electoresTotales ? `${fmt(electoresTotales)} hábiles en padrón` : 'Esperando datos';
    }

    // KPI 4: Mesas Pendientes
    $('kpi-mesas-pendientes').textContent = fmt(pendientes);
    $('kpi-pendientes-sub').textContent = pendientes === 0 ? '¡100% concluido!' : `${pct(pendientes, todas.length)} faltante`;

    // --- Gráfico 1: Barras de Avance por Distrito ---
    const distritosDatos = d.distritos.map((x) => {
      const lista = mesas(d, { distrito: x.id });
      const n = lista.filter((u) => mesaContada(d, u.mesa)).length;
      const px = porcentaje(n, lista.length);
      return {
        nombre: x.corto ?? x.nombre,
        total: lista.length,
        contadas: n,
        pctNum: Number(px.toFixed(1)),
        pctTexto: pct(n, lista.length),
      };
    });

    avanceDistritos = distritosDatos;
    const canvasDistritos = $<HTMLCanvasElement>('chart-resumen-distritos');
    const labelsDistritos = distritosDatos.map((x) => x.nombre);
    const dataComputadas = distritosDatos.map((x) => x.contadas);
    const dataPendientes = distritosDatos.map((x) => x.total - x.contadas);

    if (chartDistritos) {
      chartDistritos.data.labels = labelsDistritos;
      chartDistritos.data.datasets[0].data = dataComputadas;
      chartDistritos.data.datasets[1].data = dataPendientes;
      chartDistritos.data.datasets[1].backgroundColor = c.isDark ? '#253043' : '#e2e8f0';
      chartDistritos.options.scales!.x!.grid!.color = c.gridColor;
      chartDistritos.options.scales!.x!.ticks!.color = c.mutedColor;
      chartDistritos.options.scales!.y!.ticks!.color = c.textColor;
      chartDistritos.options.plugins!.tooltip!.backgroundColor = c.tooltipBg;
      chartDistritos.options.plugins!.tooltip!.titleColor = c.textColor;
      chartDistritos.options.plugins!.tooltip!.bodyColor = c.textColor;
      chartDistritos.options.plugins!.tooltip!.borderColor = c.tooltipBorder;
      chartDistritos.update();
    } else {
      chartDistritos = new Chart(canvasDistritos, {
        type: 'bar',
        data: {
          labels: labelsDistritos,
          datasets: [
            {
              label: 'Mesas Computadas',
              data: dataComputadas,
              backgroundColor: '#10b981',
              borderRadius: 5,
              borderSkipped: false,
              barThickness: 20,
            },
            {
              label: 'Mesas Pendientes',
              data: dataPendientes,
              backgroundColor: c.isDark ? '#253043' : '#e2e8f0',
              borderRadius: 5,
              borderSkipped: false,
              barThickness: 20,
            },
          ],
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          animation: { duration: 350 },
          plugins: {
            legend: {
              display: true,
              position: 'top',
              labels: {
                color: c.textColor,
                font: { family: 'inherit', size: 11, weight: 600 },
                boxWidth: 12,
                boxHeight: 12,
                borderRadius: 3,
                useBorderRadius: true,
              },
            },
            tooltip: {
              backgroundColor: c.tooltipBg,
              titleColor: c.textColor,
              bodyColor: c.textColor,
              borderColor: c.tooltipBorder,
              borderWidth: 1,
              padding: 10,
              callbacks: {
                afterTitle: (items) => {
                  const idx = items[0]?.dataIndex ?? 0;
                  const item = avanceDistritos[idx];
                  return `Avance: ${item?.pctTexto || '0%'} (${item?.contadas || 0} de ${item?.total || 0} mesas)`;
                },
              },
            },
          },
          scales: {
            x: {
              stacked: true,
              grid: { color: c.gridColor },
              ticks: {
                color: c.mutedColor,
                font: { family: 'inherit', size: 11 },
                precision: 0,
              },
            },
            y: {
              stacked: true,
              grid: { display: false },
              ticks: {
                color: c.textColor,
                font: { family: 'inherit', weight: 600, size: 12 },
              },
            },
          },
        },
      });
    }

    // --- Gráfico 2: Dona de Estado de Mesas Provincial ---
    const canvasMesas = $<HTMLCanvasElement>('chart-resumen-mesas');
    const donutLeyenda = $('resumen-donut-leyenda');
    const donutData = [contadas, pendientes];
    const donutLabels = ['Mesas Computadas', 'Mesas Pendientes'];
    const donutColors = ['#10b981', c.isDark ? '#2c3446' : '#cbd5e1'];

    if (chartMesas) {
      chartMesas.data.datasets[0].data = donutData;
      chartMesas.data.datasets[0].backgroundColor = donutColors;
      chartMesas.data.datasets[0].borderColor = c.surface;
      chartMesas.options.plugins!.tooltip!.backgroundColor = c.tooltipBg;
      chartMesas.options.plugins!.tooltip!.titleColor = c.textColor;
      chartMesas.options.plugins!.tooltip!.bodyColor = c.textColor;
      chartMesas.options.plugins!.tooltip!.borderColor = c.tooltipBorder;
      chartMesas.update();
    } else {
      chartMesas = new Chart(canvasMesas, {
        type: 'doughnut',
        data: {
          labels: donutLabels,
          datasets: [
            {
              data: donutData,
              backgroundColor: donutColors,
              borderColor: c.surface,
              borderWidth: 2,
              hoverOffset: 6,
            },
          ],
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '68%',
          animation: { duration: 350 },
          plugins: {
            legend: { display: false },
            tooltip: {
              backgroundColor: c.tooltipBg,
              titleColor: c.textColor,
              bodyColor: c.textColor,
              borderColor: c.tooltipBorder,
              borderWidth: 1,
              padding: 10,
              callbacks: {
                label: (ctx) => {
                  const val = ctx.raw as number;
                  return ` ${fmt(val)} mesas (${pct(val, todas.length)})`;
                },
              },
            },
          },
        },
      });
    }

    donutLeyenda.innerHTML = `
      <div class="dash-legend-item">
        <span class="dash-legend-dot" style="background:#10b981"></span>
        <span>Computadas:</span>
        <span class="dash-legend-val">${fmt(contadas)} (${pct(contadas, todas.length)})</span>
      </div>
      <div class="dash-legend-item">
        <span class="dash-legend-dot" style="background:${donutColors[1]}"></span>
        <span>Pendientes:</span>
        <span class="dash-legend-val">${fmt(pendientes)} (${pct(pendientes, todas.length)})</span>
      </div>
    `;
  }

  function pintar() {
    const todas = mesas(d);
    const contadas = todas.filter((u) => mesaContada(d, u.mesa)).length;
    const colegios = d.distritos.reduce((t, x) => t + x.colegios.length, 0);
    const partidos = d.columnas.reduce((t, c) => t + c.partidos.length, 0);
    const p = porcentaje(contadas, todas.length);

    $('kpis').innerHTML = `
      <section class="card kpi">
        <div class="et">Mesas contadas</div>
        <div class="valor">${fmt(contadas)} <small>de ${fmt(todas.length)} · ${pct(contadas, todas.length)}</small></div>
        <div class="progreso-barra${contadas && contadas === todas.length ? ' ok' : ''}" style="--p:${p.toFixed(1)}%"><span></span></div>
      </section>
      <section class="card kpi"><div class="et">Distritos</div><div class="valor">${fmt(d.distritos.length)}</div></section>
      <section class="card kpi"><div class="et">Colegios</div><div class="valor">${fmt(colegios)}</div></section>
      <section class="card kpi"><div class="et">Partidos</div><div class="valor">${fmt(partidos)} <small>en ${d.columnas.length} columnas</small></div></section>`;

    actualizarDashboardResumen();

    $('avance').innerHTML = d.distritos
      .map((x) => {
        const lista = mesas(d, { distrito: x.id });
        const n = lista.filter((u) => mesaContada(d, u.mesa)).length;
        const px = porcentaje(n, lista.length);
        return `
        <tr>
          <td class="principal">${esc(x.nombre)}</td>
          <td class="n" data-et="Colegios">${fmt(x.colegios.length)}</td>
          <td class="n" data-et="Mesas">${fmt(lista.length)}</td>
          <td class="n" data-et="Contadas">${fmt(n)}</td>
          <td data-et="Avance">
            <div class="celda-avance">
              <div class="progreso-barra${n && n === lista.length ? ' ok' : ''}" style="--p:${px.toFixed(1)}%"><span></span></div>
              <span class="n">${pct(n, lista.length)}</span>
            </div>
          </td>
          <td data-et="N° de mesa">${x.confirmado ? '<span class="chip ok">Del 4 de octubre</span>' : '<span class="chip warn">Por confirmar</span>'}</td>
          <td class="acciones-fila dos">
            <a class="link-fila" href="${BASE}/admin/resultados?distrito=${encodeURIComponent(x.id)}">Ver total</a>
            <a class="link-fila" href="${BASE}/admin/mesas?distrito=${encodeURIComponent(x.id)}">Ver mesas</a>
          </td>
        </tr>`;
      })
      .join('');
  }

  const hoy = () => new Date().toISOString().slice(0, 10);

  $('json').addEventListener('click', () => {
    descargar(`conteo-votos-respaldo-${hoy()}.json`, JSON.stringify(d, null, 2), 'application/json');
  });

  $('importar').addEventListener('click', () => archivo.click());
  archivo.addEventListener('change', async () => {
    const file = archivo.files?.[0];
    archivo.value = '';
    if (!file) return;
    try {
      const nuevo = JSON.parse(await file.text());
      if (!esDatos(nuevo)) throw new Error('formato');
      if (!confirm(`Esto reemplazará todos los datos actuales por los del respaldo.${paraTodos} ¿Continuar?`)) return;
      // Se reemplaza en el mismo objeto: la conexión con la nube lo sigue usando.
      Object.assign(d, normalizar(nuevo));
      guardar(d);
      pintar();
    } catch {
      alert('El archivo no es un respaldo válido del conteo de votos.');
    }
  });

  $('borrar-votos').addEventListener('click', () => {
    if (!confirm(`¿Borrar los votos de todas las mesas? Los colegios, aulas, mesas y partidos se mantienen.${paraTodos}`)) return;
    for (const { mesa } of mesas(d)) mesa.votos = {};
    guardar(d);
    pintar();
  });

  $('borrar-todo').addEventListener('click', () => {
    if (!confirm(`¿Borrar TODO y volver al inicio (colegios de la ONPE y partidos originales)? Se pierden todos los votos.${paraTodos}`)) return;
    Object.assign(d, datosIniciales());
    guardar(d);
    pintar();
  });

  const vacia = $('nube-vacia');
  alEstado((estado) => {
    vacia.hidden = estado !== 'vacia';
  });
  $('sembrar').addEventListener('click', async () => {
    if (!confirm('¿Subir a Supabase los colegios, mesas, partidos y votos de este navegador?')) return;
    $<HTMLButtonElement>('sembrar').disabled = true;
    await sembrar(d);
    pintar();
  });

  // Observador para cambios de modo oscuro / claro
  const obsTema = new MutationObserver(() => {
    actualizarDashboardResumen();
  });
  obsTema.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

  pintar();
  conectar(d, pintar, { enVivo: true });
</script>
