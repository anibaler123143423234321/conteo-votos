---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Colegios y mesas">
  <div class="cabecera">
    <h1>Colegios y mesas</h1>
    <span class="muted" id="resumen"></span>
  </div>

  <section class="card">
    <div class="segmentos" id="distritos" role="tablist" aria-label="Distritos"></div>
    <div class="distrito-info">
      <p class="nota" id="nota-distrito"></p>
      <button type="button" class="btn" id="restaurar">Restaurar este distrito</button>
    </div>
  </section>

  <section class="card">
    <h2 class="card-titulo" id="titulo-agregar">Agregar colegio</h2>
    <form class="form-colegio" id="form-colegio">
      <label class="campo campo-nombre">
        <span class="campo-et">Nombre</span>
        <input name="nombre" required placeholder="Ej.: I.E. San Martín" autocomplete="off" />
      </label>
      <label class="campo">
        <span class="campo-et">Aulas</span>
        <input name="aulas" type="number" inputmode="numeric" min="1" max="200" value="1" required />
      </label>
      <label class="campo">
        <span class="campo-et">Mesas por aula</span>
        <input name="mesas" type="number" inputmode="numeric" min="1" max="50" value="1" required />
      </label>
      <button class="btn primary">Agregar</button>
    </form>
  </section>

  <div class="lista-colegios" id="lista"></div>
</Layout>

<script>
  import {
    cargar,
    colegiosDe,
    entero,
    esc,
    fmt,
    guardar,
    mesaContada,
    mesas,
    numeradorMesas,
    nuevaMesa,
    uid,
    type Aula,
    type Distrito,
  } from '../lib/store';

  const CLAVE_DISTRITO = 'conteo-votos:distrito-colegios';
  const d = cargar();
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const form = $<HTMLFormElement>('form-colegio');
  const lista = $('lista');
  const segmentos = $('distritos');
  // Colegios con la lista de aulas desplegada (se mantiene al redibujar).
  const abiertos = new Set<string>();

  const limitar = (n: number, min: number, max: number) => Math.min(max, Math.max(min, n));
  const mesasDe = (x: Distrito) => x.colegios.reduce((t, c) => t + c.aulas.reduce((s, a) => s + a.mesas.length, 0), 0);

  // Empieza en el distrito elegido aquí antes o, si no, en el del conteo.
  let distrito: Distrito = d.distritos[0];
  try {
    const id =
      localStorage.getItem(CLAVE_DISTRITO) ??
      JSON.parse(localStorage.getItem('conteo-votos:seleccion') ?? '{}').di;
    distrito = d.distritos.find((x) => x.id === id) ?? distrito;
  } catch {
    // Primer distrito.
  }

  function pintar() {
    const colegios = d.distritos.reduce((t, x) => t + x.colegios.length, 0);
    const total = d.distritos.reduce((t, x) => t + mesasDe(x), 0);
    $('resumen').textContent = `Provincia de ${d.provincia}: ${d.distritos.length} distritos · ${colegios} colegios · ${fmt(total)} mesas`;

    segmentos.innerHTML = d.distritos
      .map(
        (x) =>
          `<button type="button" role="tab" data-di="${esc(x.id)}" aria-selected="${x === distrito}">${esc(x.corto ?? x.nombre)}<span class="tab-n">${fmt(mesasDe(x))}</span></button>`,
      )
      .join('');

    const numeros = distrito.colegios.flatMap((c) => c.aulas.flatMap((a) => a.mesas.map((m) => m.numero))).sort();
    const rango = numeros.length ? ` (${numeros[0]} al ${numeros[numeros.length - 1]})` : '';
    $('nota-distrito').textContent =
      `Distrito de ${distrito.nombre}: ${distrito.colegios.length} colegios y ${numeros.length} mesas${rango}. ` +
      (distrito.confirmado
        ? 'Números de mesa del 4 de octubre. '
        : 'Los números de mesa son de la segunda vuelta de junio (ONPE) y pueden cambiar para el 4 de octubre: corrígelos abajo cuando tengas la lista. ') +
      'La ONPE no publica las aulas: cada mesa tiene su propia aula y puedes ponerle el nombre real.';
    $('titulo-agregar').textContent = `Agregar colegio en ${distrito.nombre}`;

    if (!distrito.colegios.length) {
      lista.innerHTML = '<p class="card empty">Este distrito todavía no tiene colegios. Agrega el primero arriba.</p>';
      return;
    }

    lista.innerHTML = distrito.colegios
      .map((c) => {
        const ms = c.aulas.flatMap((a) => a.mesas);
        const meta = [c.codigo && `Local ONPE ${esc(c.codigo)}`, `${c.aulas.length} aulas`, `${ms.length} mesas`].filter(Boolean);
        return `
      <section class="card colegio" data-c="${esc(c.id)}">
        <div class="colegio-head">
          <input class="input-titulo" data-f="colegio" value="${esc(c.nombre)}" aria-label="Nombre del colegio" />
          <button type="button" class="icon-btn danger" data-accion="quitar-colegio" aria-label="Eliminar colegio" title="Eliminar colegio">✕</button>
        </div>
        <p class="colegio-meta">${meta.join(' · ')}</p>
        <details ${abiertos.has(c.id) ? 'open' : ''}>
          <summary>Aulas y mesas</summary>
          <div class="aulas">
            ${c.aulas
              .map(
                (a) => `
              <div class="aula" data-aula="${esc(a.id)}">
                <label class="campo"><span class="campo-et">Aula</span><input data-f="aula" value="${esc(a.nombre)}" /></label>
                <label class="campo"><span class="campo-et">Mesas</span><input type="number" inputmode="numeric" min="1" max="50" data-f="cantidad" value="${a.mesas.length}" /></label>
                <div class="chips">
                  <span class="campo-et">N°</span>
                  ${a.mesas
                    .map(
                      (m) =>
                        `<input class="control mesa-num" data-f="mesa" data-mesa="${esc(m.id)}" value="${esc(m.numero)}" aria-label="Número de mesa" />`,
                    )
                    .join('')}
                </div>
                <button type="button" class="icon-btn danger" data-accion="quitar-aula" aria-label="Eliminar ${esc(a.nombre)}" title="Eliminar aula">✕</button>
              </div>`,
              )
              .join('')}
          </div>
          <button type="button" class="btn" data-accion="agregar-aula">+ Agregar aula</button>
        </details>
      </section>`;
      })
      .join('');
  }

  function crearAula(nombre: string, cantidad: number, numero: () => string): Aula {
    return { id: uid(), nombre, mesas: Array.from({ length: cantidad }, () => nuevaMesa(numero())) };
  }

  function ajustarMesas(a: Aula, cantidad: number) {
    const n = limitar(cantidad, 1, 50);
    if (n > a.mesas.length) {
      const numero = numeradorMesas(d, distrito.id);
      while (a.mesas.length < n) a.mesas.push(nuevaMesa(numero()));
    } else if (n < a.mesas.length) {
      const conVotos = a.mesas.slice(n).some((m) => mesaContada(d, m));
      if (conVotos && !confirm('Algunas de las mesas que se quitarán ya tienen votos. ¿Quitarlas igual?')) return;
      a.mesas.splice(n);
    }
  }

  segmentos.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-di]');
    const x = d.distritos.find((y) => y.id === b?.dataset.di);
    if (!x) return;
    distrito = x;
    abiertos.clear();
    try {
      localStorage.setItem(CLAVE_DISTRITO, x.id);
    } catch {
      // No importa si no se puede recordar.
    }
    pintar();
  });

  $('restaurar').addEventListener('click', () => {
    const hayVotos = mesas(d, { distrito: distrito.id }).some((u) => mesaContada(d, u.mesa));
    const aviso = hayVotos ? ' Se perderán los votos ya registrados en este distrito.' : '';
    if (!confirm(`¿Volver a la lista original de colegios y mesas de ${distrito.nombre}?${aviso}`)) return;
    distrito.colegios = colegiosDe(distrito.id);
    abiertos.clear();
    guardar(d);
    pintar();
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const datos = new FormData(form);
    const nombre = String(datos.get('nombre') ?? '').trim();
    if (!nombre) return;
    const nAulas = limitar(entero(datos.get('aulas')), 1, 200);
    const nMesas = limitar(entero(datos.get('mesas')), 1, 50);
    const numero = numeradorMesas(d, distrito.id);
    const id = uid();
    distrito.colegios.push({
      id,
      nombre,
      aulas: Array.from({ length: nAulas }, (_, i) => crearAula(`Aula ${i + 1}`, nMesas, numero)),
    });
    abiertos.add(id);
    guardar(d);
    form.reset();
    pintar();
  });

  // El evento toggle no burbujea: se escucha en captura.
  lista.addEventListener(
    'toggle',
    (e) => {
      const det = e.target as HTMLDetailsElement;
      const id = det.closest<HTMLElement>('[data-c]')?.dataset.c;
      if (!id) return;
      if (det.open) abiertos.add(id);
      else abiertos.delete(id);
    },
    true,
  );

  lista.addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement;
    const c = distrito.colegios.find((x) => x.id === el.closest<HTMLElement>('[data-c]')?.dataset.c);
    const a = c?.aulas.find((x) => x.id === el.closest<HTMLElement>('[data-aula]')?.dataset.aula);
    if (!c) return;
    const valor = el.value.trim();

    // Renombrar no redibuja la lista, así no se pierde el foco del siguiente campo.
    switch (el.dataset.f) {
      case 'colegio':
        if (valor) c.nombre = valor;
        el.value = c.nombre;
        break;
      case 'aula':
        if (!a) return;
        if (valor) a.nombre = valor;
        el.value = a.nombre;
        break;
      case 'mesa': {
        const m = a?.mesas.find((x) => x.id === el.dataset.mesa);
        if (!m) return;
        if (valor) m.numero = valor;
        el.value = m.numero;
        break;
      }
      case 'cantidad':
        if (a) ajustarMesas(a, entero(el.value));
        guardar(d);
        pintar();
        return;
    }
    guardar(d);
  });

  lista.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-accion]');
    const c = distrito.colegios.find((x) => x.id === b?.closest<HTMLElement>('[data-c]')?.dataset.c);
    if (!b || !c) return;

    switch (b.dataset.accion) {
      case 'quitar-colegio':
        if (!confirm(`¿Eliminar "${c.nombre}" con todas sus aulas, mesas y votos?`)) return;
        distrito.colegios = distrito.colegios.filter((x) => x !== c);
        break;
      case 'quitar-aula': {
        const a = c.aulas.find((x) => x.id === b.closest<HTMLElement>('[data-aula]')?.dataset.aula);
        if (!a || !confirm(`¿Eliminar "${a.nombre}" con sus mesas y votos?`)) return;
        c.aulas = c.aulas.filter((x) => x !== a);
        break;
      }
      case 'agregar-aula':
        c.aulas.push(crearAula(`Aula ${c.aulas.length + 1}`, 1, numeradorMesas(d, distrito.id)));
        break;
    }
    guardar(d);
    pintar();
  });

  pintar();
</script>
