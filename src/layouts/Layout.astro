---
import Base from './Base.astro';
import TemaBoton from '../components/TemaBoton.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title={title}>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href={`${base}/`}>
        <img src={`${base}/favicon.svg`} alt="" width="24" height="24" />
        <span>Conteo de votos</span>
      </a>
      <span class="brand-sub">Provincia de Ferreñafe · Elecciones Regionales y Municipales 2026</span>
      <TemaBoton />
      <button type="button" class="btn chico" data-salir hidden>Salir</button>
    </div>
  </header>
  <main class="container">
    <slot />
  </main>
</Base>
