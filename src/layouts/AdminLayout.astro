---
import Base from './Base.astro';
import TemaBoton from '../components/TemaBoton.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const actual = Astro.url.pathname.slice(base.length).replace(/\/$/, '') || '/';
// Los personeros solo existen con Supabase (cada uno entra con su cuenta).
const nube = Boolean(import.meta.env.PUBLIC_SUPABASE_URL && import.meta.env.PUBLIC_SUPABASE_ANON_KEY);

// Íconos de trazo simple (24×24).
const iconos = {
  resumen: '<rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>',
  resultados: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>',
  colegios: '<path d="M3 21h18M5 21V9l7-5 7 5v12"/><path d="M10 21v-5h4v5"/>',
  mesas: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 10v10"/>',
  partidos: '<path d="M5 21V4M5 4h11l-2 4 2 4H5"/>',
  personeros:
    '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M21.5 20a6.5 6.5 0 0 0-4-6"/>',
};

const enlaces = [
  { href: '/admin', texto: 'Resumen', icono: iconos.resumen },
  { href: '/admin/resultados', texto: 'Resultados', icono: iconos.resultados },
  { href: '/admin/colegios', texto: 'Colegios', icono: iconos.colegios },
  { href: '/admin/mesas', texto: 'Mesas', icono: iconos.mesas },
  { href: '/admin/partidos', texto: 'Partidos', icono: iconos.partidos },
  ...(nube ? [{ href: '/admin/personeros', texto: 'Personeros', icono: iconos.personeros }] : []),
];
---

<Base title={`${title} · Administración`} zona="admin">
  <div class="admin">
    <aside class="admin-side">
      <a class="brand" href={`${base}/admin`}>
        <img src={`${base}/favicon.svg`} alt="" width="24" height="24" />
        <span>Administración<small>Ferreñafe · ERM 2026</small></span>
      </a>
      <nav class="admin-nav" aria-label="Administración">
        {
          enlaces.map((e) => (
            <a href={`${base}${e.href}`} aria-current={actual === e.href ? 'page' : undefined}>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={e.icono}
              />
              {e.texto}
            </a>
          ))
        }
      </nav>
      <div class="admin-side-pie">
        <span class="chip" data-nube hidden></span>
        <a class="btn" href={`${base}/`} title="Ir a la pantalla de conteo">← Ir al conteo</a>
        <TemaBoton />
        <button type="button" class="btn chico" data-salir hidden>Salir</button>
      </div>
    </aside>
    <main class="admin-main">
      <slot />
    </main>
  </div>
</Base>

<script>
  // En celular el menú se desliza de lado: que se vea la página en la que estás.
  const nav = document.querySelector<HTMLElement>('.admin-nav');
  const activa = nav?.querySelector<HTMLElement>('[aria-current="page"]');
  if (nav && activa && nav.scrollWidth > nav.clientWidth) {
    const a = activa.getBoundingClientRect();
    const n = nav.getBoundingClientRect();
    nav.scrollLeft += a.left - n.left - (n.width - a.width) / 2;
  }
</script>
